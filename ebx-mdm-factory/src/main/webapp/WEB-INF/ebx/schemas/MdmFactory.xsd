<?xml version='1.0' encoding='UTF-8'?>
<!--MdmFactory: data model of the ebx-mdm-factory module (com.on.ebx.factory). Generated by tools/build_xsd.py; do not edit by hand.-->
<xs:schema xmlns:osd="urn:ebx-schemas:common_1.0" xmlns:fmt="urn:ebx-schemas:format_1.0" xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:import namespace="urn:ebx-schemas:common_1.0" schemaLocation="http://schema.orchestranetworks.com/common_1.0.xsd"/>
    <xs:annotation>
        <xs:appinfo>
            <osd:validation>
                <validationMessageThreshold>1000</validationMessageThreshold>
            </osd:validation>
            <osd:inheritance>
                <dataSetInheritance>none</dataSetInheritance>
            </osd:inheritance>
            <osd:extensions class="com.on.ebx.factory.ebx.FactorySchemaExtensions"/>
        </xs:appinfo>
    </xs:annotation>
    <xs:element name="root" osd:access="--">
        <xs:complexType>
            <xs:sequence>

                <xs:element name="FactorySettings" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Settings</osd:label>
                            <osd:description>How the factory reaches the language model and the MCP servers, and the defaults of a new project.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Paramètres</osd:label>
                            <osd:description>Comment la factory joint le modèle de langage et les serveurs MCP, et les valeurs par défaut d'un nouveau projet.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/code </primaryKeys>
                                <defaultLabel>${./code}</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="code" minOccurs="1" maxOccurs="1" default="DEFAULT">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Code</osd:label>
                                        <osd:description>Only the DEFAULT row is read.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Code</osd:label>
                                        <osd:description>Seule la ligne DEFAULT est lue.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="instanceId" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Instance identifier</osd:label>
                                        <osd:description>Random identifier of this EBX instance, written once at installation. A project created here carries it as its origin; a project delivered by EBX Staging carries the origin of its source instance and refuses suggestions here.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Identifiant de l'instance</osd:label>
                                        <osd:description>Identifiant aléatoire de cette instance EBX, écrit une fois à l'installation. Un projet créé ici le porte comme origine ; un projet livré par le Staging EBX porte l'origine de son instance source et refuse les suggestions ici.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="agentActivationKey" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Agent activation key</osd:label>
                                        <osd:description>Secret key, written once by the module (32 random bytes in hexadecimal). Never shown, never exported. It signs who an agent acts for; a repository restored elsewhere keeps it, a new repository draws its own (agents are then switched on again).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Clé d'activation des agents</osd:label>
                                        <osd:description>Clé secrète, écrite une fois par le module (32 octets aléatoires en hexadécimal). Jamais affichée, jamais exportée. Elle signe pour qui un agent agit ; un dépôt restauré ailleurs la garde, un dépôt neuf en tire une nouvelle (les agents y sont à réactiver).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="128"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="role" minOccurs="1" maxOccurs="1" default="DEVELOPMENT">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Instance role</osd:label>
                                        <osd:description>DEVELOPMENT (default): the wizard may create a new project. TARGET: this instance only receives projects delivered by EBX Staging; project creation is refused, whether attempted from the wizard or posted directly.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Rôle de l'instance</osd:label>
                                        <osd:description>DÉVELOPPEMENT (défaut) : l'assistant peut créer un nouveau projet. CIBLE : cette instance ne fait que recevoir des projets livrés par le Staging EBX ; la création d'un projet est refusée, que ce soit depuis l'assistant ou par un envoi direct.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="DEVELOPMENT">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Development: projects are designed here</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Développement : les projets sont conçus ici</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="TARGET">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Target: projects arrive by EBX Staging, none is created here</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Cible : les projets arrivent par le Staging EBX, aucun n'est créé ici</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="llmConnector" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Language model connector</osd:label>
                                        <osd:description>Id of a connector of type llm in ebx-connectors. Empty: the factory works with its deterministic rules only.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Connecteur du modèle de langage</osd:label>
                                        <osd:description>Identifiant d'un connecteur de type llm dans ebx-connectors. Vide : la factory ne travaille qu'avec ses règles déterministes.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="ebxBaseUrl" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Internal EBX address</osd:label>
                                        <osd:description>Optional. Empty: the factory calls this node itself through its own Tomcat HTTP connector (&lt;base&gt;/ebx-assistant/mcp/v1/&lt;server&gt;, &lt;base&gt;/ebx-connectors/rest/mcp). Fill it only when that detection fails, with an address of THIS node (e.g. http://127.0.0.1:8080), never the public address behind a load balancer.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Adresse interne d'EBX</osd:label>
                                        <osd:description>Optionnelle. Vide : la factory appelle ce nœud lui-même par son propre connecteur HTTP Tomcat (&lt;base&gt;/ebx-assistant/mcp/v1/&lt;serveur&gt;, &lt;base&gt;/ebx-connectors/rest/mcp). Ne la remplir que si cette détection échoue, avec une adresse de CE nœud (ex. http://127.0.0.1:8080), jamais l'adresse publique derrière un load balancer.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="ebxNamespace" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Lineage namespace</osd:label>
                                        <osd:description>Optional. How this instance is named in the data catalog (ebx://host:port); must match the ebx.namespace of the ebx-connectors openlineage connector. Empty: ebx://localhost:8080, the ebx-connectors default.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Namespace du lineage</osd:label>
                                        <osd:description>Optionnel. Le nom de cette instance dans le catalogue de données (ebx://hôte:port) ; doit être le même que l'ebx.namespace du connecteur openlineage d'ebx-connectors. Vide : ebx://localhost:8080, la valeur par défaut d'ebx-connectors.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="agentUser" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Agent account: user</osd:label>
                                        <osd:description>The EBX user every generation step and every tool call of the agent runs as, on all the MCP servers of this instance. What this account may do is what the factory may do: use a dedicated, least-privileged account.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Compte de l'agent : utilisateur</osd:label>
                                        <osd:description>L'utilisateur EBX sous lequel tournent toutes les étapes de génération et tous les appels d'outils de l'agent, sur tous les serveurs MCP de cette instance. Ce que ce compte peut faire, la factory peut le faire : prendre un compte dédié, aux droits minimaux.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="agentPassword" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Agent account: password</osd:label>
                                        <osd:description>Stored with the reversible encryption of EBX. A reference env:NAME or file:/path is read from the environment or the file instead.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Compte de l'agent : mot de passe</osd:label>
                                        <osd:description>Stocké avec le chiffrement réversible d'EBX. Une référence env:NOM ou file:/chemin est lue dans l'environnement ou le fichier.</osd:description>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:uiBean class="com.orchestranetworks.ui.UIPassword">
                                            <encryptionClass>com.orchestranetworks.security.PasswordTypeEncryption</encryptionClass>
                                        </osd:uiBean>
                                    </xs:appinfo>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:password">
                                        <xs:maxLength value="4000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="agentFallback" minOccurs="0" maxOccurs="1" default="AUTO">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Agent account fallback</osd:label>
                                        <osd:description>Every call normally runs as its caller (in-JVM bridge, session token). When that is impossible (no session, bridge not registered, token not mintable), the agent account, often more privileged, would take over: this decides whether it may. A fallback that is allowed is written to the EBX kernel log.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Repli sur le compte de l'agent</osd:label>
                                        <osd:description>Chaque appel s'exécute normalement sous l'identité de l'appelant (pont en JVM, jeton de session). Quand c'est impossible (pas de session, pont absent, jeton non fabricable), le compte de l'agent, souvent plus puissant, prendrait le relais : ce réglage dit s'il le peut. Un repli autorisé est écrit dans le journal du noyau EBX.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="AUTO">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Automatic: allowed on a development instance, forbidden on a target</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Automatique : autorisé sur une instance de développement, interdit sur une cible</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="ALLOWED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Allowed (logged)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Autorisé (journalisé)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="FORBIDDEN">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Forbidden: the call fails instead</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Interdit : l'appel échoue</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="20"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="pipelineLauncherRole" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Pipeline launcher role</osd:label>
                                        <osd:description>Specific EBX role the launcher of a factory workflow (MdmFactoryPipeline and its beans) must hold; empty: administrators only. Checked by every bean at run time, whatever the publication permissions say: a workflow step runs with all privileges.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Rôle du lanceur du pipeline</osd:label>
                                        <osd:description>Rôle EBX spécifique que doit détenir le lanceur d'un workflow de la factory (MdmFactoryPipeline et ses beans) ; vide : administrateurs uniquement. Vérifié par chaque bean à l'exécution, quelles que soient les permissions de la publication : une étape de workflow tourne avec tous les privilèges.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="llmValueSharingMax" minOccurs="0" maxOccurs="1" default="SHAPES_ONLY">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Language model: most data a project may share</osd:label>
                                        <osd:description>Caps each project's own value-sharing choice: the more restrictive of the two applies.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Modèle de langage : partage de données maximal par projet</osd:label>
                                        <osd:description>Plafonne le choix de partage de chaque projet : le plus restrictif des deux s'applique.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="NONE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">None: metadata and statistics only, not even value shapes</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Aucun : métadonnées et statistiques seulement, pas même la forme des valeurs</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="SHAPES_ONLY">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Shapes only (letters to a/A, digits to 9)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Formes seulement (lettres en a/A, chiffres en 9)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="SAMPLE_VALUES">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">A project may opt in to real sample values</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Un projet peut choisir d'envoyer de vraies valeurs</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="20"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="llmSensitiveColumns" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Language model: sensitive column names</osd:label>
                                        <osd:description>Column-name patterns (* wildcard, case-insensitive, comma or line separated) whose values and shapes never reach the language model. Empty: a built-in list (passwords, tokens, IBAN, social security, birth dates, health, salary...). NONE: no sensitive column at all (for an internal, confidential model).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Modèle de langage : noms de colonnes sensibles</osd:label>
                                        <osd:description>Motifs de noms de colonnes (joker *, sans casse, séparés par virgule ou ligne) dont ni les valeurs ni les formes ne partent vers le modèle de langage. Vide : une liste intégrée (mots de passe, jetons, IBAN, sécurité sociale, dates de naissance, santé, salaire...). NONE : aucune colonne sensible (pour un modèle interne et confidentiel).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="jobsMaxParallel" type="xs:int" minOccurs="0" maxOccurs="1" default="4">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Background jobs: how many at once</osd:label>
                                        <osd:description>How many factory runs (landing, staging, master, language-model passes...) execute at the same time across all projects; more wait in a queue. Read when the module starts. Within a project, one run at a time per resource (sources, landing, design, staging, master, matching); requests for a busy resource wait in line.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Tâches de fond : nombre simultané</osd:label>
                                        <osd:description>Combien d'exécutions de la factory (landing, staging, MDM, passes du modèle de langage...) tournent en même temps, tous projets confondus ; les autres attendent. Lu au démarrage du module. Dans un projet, une exécution à la fois par ressource (sources, landing, conception, staging, MDM, rapprochement) ; les demandes sur une ressource occupée attendent leur tour.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="jobMaxMinutes" type="xs:int" minOccurs="0" maxOccurs="1" default="120">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Background jobs: inactivity limit (minutes)</osd:label>
                                        <osd:description>A run that goes this many minutes with no check-in at all (never between two active stages/batches, however long they individually take) is stopped between two stages. Not a cap on the run's total duration.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Tâches de fond : limite d'inactivité (minutes)</osd:label>
                                        <osd:description>Une exécution qui reste sans le moindre signal de vie pendant ce nombre de minutes (jamais entre deux étapes/lots actifs, quelle que soit leur durée individuelle) est arrêtée entre deux étapes. Ce n'est pas un plafond sur la durée totale de l'exécution.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="historyRetentionDays" type="xs:int" minOccurs="0" maxOccurs="1" default="90">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>History: days kept</osd:label>
                                        <osd:description>Once a day, finished background jobs, language-model runs and pipeline steps older than this are deleted. The pipeline steps that prove a dataspace or dataset was created by the factory, and the latest successful step of each kind, are always kept. 0: keep everything.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Historique : jours conservés</osd:label>
                                        <osd:description>Une fois par jour, les tâches de fond terminées, les exécutions du modèle de langage et les étapes du pipeline plus anciennes sont supprimées. Les étapes qui prouvent qu'un espace ou un jeu de données a été créé par la factory, et la dernière étape réussie de chaque sorte, sont toujours gardées. 0 : tout garder.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="mcpConnectors" minOccurs="0" maxOccurs="unbounded">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>MCP server connectors</osd:label>
                                        <osd:description>Optional: ids of connectors of type mcp for MCP servers outside this EBX instance, each with its own endpoint and account. The servers of this instance need none: they are reached with the agent account above.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Connecteurs des serveurs MCP</osd:label>
                                        <osd:description>Optionnel : identifiants de connecteurs de type mcp pour des serveurs MCP hors de cette instance EBX, chacun avec son point d'accès et son compte. Les serveurs de cette instance n'en ont pas besoin : ils sont joints avec le compte de l'agent ci-dessus.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="maxAgentSteps" type="xs:int" minOccurs="0" maxOccurs="1" default="30">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Agent: maximum steps per run</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Agent : nombre maximal de pas par exécution</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="maxAgentTokens" type="xs:int" minOccurs="0" maxOccurs="1" default="300000">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Agent: maximum tokens per run</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Agent : nombre maximal de jetons par exécution</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="landingSuffix" minOccurs="0" maxOccurs="1" default="_Landing">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Landing dataspace suffix</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Suffixe du dataspace de landing</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="stagingSuffix" minOccurs="0" maxOccurs="1" default="_Staging">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Staging dataspace suffix</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Suffixe du dataspace de staging</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="masterSuffix" minOccurs="0" maxOccurs="1" default="_Master">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Master dataspace suffix</osd:label>
                                        <osd:description>The master data model is always &lt;ProjectCode&gt;_Master; this suffix only names its dataspace.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Suffixe du dataspace MDM</osd:label>
                                        <osd:description>Le modèle MDM est toujours &lt;ProjetCode&gt;_Master ; ce suffixe ne nomme que son dataspace.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="lengthMargin" type="xs:int" minOccurs="0" maxOccurs="1" default="50">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Length margin (%)</osd:label>
                                        <osd:description>A staging text attribute gets the longest observed value plus this margin as its maximum length.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Marge sur les longueurs (%)</osd:label>
                                        <osd:description>Un attribut texte du staging reçoit comme longueur maximale la plus longue valeur observée plus cette marge.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="transferBatchSize" type="xs:int" minOccurs="0" maxOccurs="1" default="500">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Transfer: batch size</osd:label>
                                        <osd:description>Landing rows are upserted into staging this many at a time, one EBX transaction per batch. A row that fails inside a failing batch is retried alone, so only it is rejected.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Transfert : taille de lot</osd:label>
                                        <osd:description>Les lignes du landing sont transférées vers le staging par lots de cette taille, une transaction EBX par lot. Une ligne en échec dans un lot en échec est rejouée seule, pour que seule elle soit rejetée.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="columnProfileSampleRows" type="xs:int" minOccurs="0" maxOccurs="1" default="50000">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Column profiling: sample size (rows)</osd:label>
                                        <osd:description>Fill rate, distinct-value count and max length of a landing table's columns are measured on at most this many of its rows (EBX SQL LIMIT), not necessarily the whole table. 0: profile the whole table (the pre-existing, unbounded behaviour) - only sensible for a table known to stay small.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Profilage des colonnes : taille de l'échantillon (lignes)</osd:label>
                                        <osd:description>Le taux de remplissage, le nombre de valeurs distinctes et la longueur maximale des colonnes d'une table de landing sont mesurés sur au plus ce nombre de ses lignes (LIMIT en SQL EBX), pas forcément sur la table entière. 0 : profiler la table entière (comportement non borné d'origine) - pertinent seulement pour une table dont on sait qu'elle restera petite.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="Project" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Projects</osd:label>
                            <osd:description>One MDM build: its sources, its three zones and everything generated for it.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Projets</osd:label>
                            <osd:description>Un chantier MDM : ses sources, ses trois zones et tout ce qui a été généré pour lui.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/code </primaryKeys>
                                <defaultLabel>${./label}</defaultLabel>
                                <defaultView>
                                    <toolbars>
                                        <tabularViewTop>FactoryProjectTableTop</tabularViewTop>
                                        <tabularViewRow>FactoryProjectRow</tabularViewRow>
                                        <recordTop>FactoryProjectRecordTop</recordTop>
                                    </toolbars>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="code" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Code</osd:label>
                                        <osd:description>Prefix of everything the project generates (dataspaces, data models, flows): letters, digits and underscore.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Code</osd:label>
                                        <osd:description>Préfixe de tout ce que le projet génère (dataspaces, modèles, flux) : lettres, chiffres et souligné.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="40"/>
                                        <xs:pattern value="[A-Za-z][A-Za-z0-9_]*"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="label" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Label</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Libellé</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="description" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Description</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Description</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="mode" minOccurs="1" maxOccurs="1" default="TARGET_EXISTS">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Mode</osd:label>
                                        <osd:description>With an existing master model the staging takes its shape and the suggestions are mappings; otherwise the factory proposes the entities and their attributes.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Mode</osd:label>
                                        <osd:description>Avec un modèle MDM existant, le staging en prend la forme et les suggestions sont des mappings ; sinon la factory propose les entités et leurs attributs.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="TARGET_EXISTS">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">The master model exists</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Le modèle MDM existe</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="GREENFIELD">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">The factory proposes the model</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">La factory propose le modèle</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="style" minOccurs="1" maxOccurs="1" default="CONSOLIDATION">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Implementation style</osd:label>
                                        <osd:description>CONSOLIDATION: the sources feed a golden record in the hub. CENTRALISATION: records are authored in the hub, the model comes from a specification. COEXISTENCE: consolidation plus write-back of the golden record to the sources. REGISTRY: the hub keeps keys and cross-references only. CONSOLIDATION and CENTRALISATION are implemented today.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Style d'implémentation</osd:label>
                                        <osd:description>CONSOLIDATION : les sources alimentent un golden record dans le hub. CENTRALISATION : les enregistrements sont saisis dans le hub, le modèle vient d'une spécification. COEXISTENCE : consolidation plus réécriture du golden record vers les sources. REGISTRE : le hub ne garde que les clés et les références croisées. La CONSOLIDATION et la CENTRALISATION sont implémentées aujourd'hui.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="CONSOLIDATION">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Consolidation</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Consolidation</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="CENTRALISATION">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Centralisation</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Centralisation</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="COEXISTENCE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Coexistence (hybrid)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Coexistence (hybride)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="REGISTRY">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Registry</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Registre</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="status" minOccurs="1" maxOccurs="1" default="DRAFT">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Status</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Statut</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="DRAFT">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Draft</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Brouillon</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="LANDING">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Landing ready</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Landing prêt</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="STAGING">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Staging ready</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Staging prêt</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="LIVE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Live</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">En service</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="ARCHIVED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Archived</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Archivé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="landingDataspace" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Landing dataspace</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dataspace de landing</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="stagingDataspace" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Staging dataspace</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dataspace de staging</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="stagingDataset" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Staging dataset</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dataset de staging</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="masterDataspace" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Master dataspace</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dataspace MDM</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="masterDataset" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Master dataset</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dataset MDM</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="owner" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Owner</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Responsable</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="createdAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Created</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Créé le</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="originRepository" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Origin instance</osd:label>
                                        <osd:description>Identifier of the EBX instance this project was designed on. Different from this instance's own: the project was delivered here by EBX Staging, and the suggestion routes refuse it.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Instance d'origine</osd:label>
                                        <osd:description>Identifiant de l'instance EBX sur laquelle ce projet a été conçu. Différent de celui de cette instance : le projet a été livré ici par le Staging EBX, et les routes de suggestion le refusent.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="llmValueSharing" minOccurs="1" maxOccurs="1" default="SHAPES_ONLY">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Language model: value sharing</osd:label>
                                        <osd:description>What a quality/suggest-llm run may send to the language model, per project. SHAPES_ONLY (default): metadata and value SHAPES only (A/a/9 patterns) - no real value ever leaves EBX. SAMPLE_VALUES: opt-in, the top llmSampleSize most frequent distinct values of each mapped column are sent too - only turn this on for a project with no sensitive column.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Modèle de langage : partage des valeurs</osd:label>
                                        <osd:description>Ce qu'une exécution de quality/suggest-llm peut envoyer au modèle de langage, par projet. SHAPES_ONLY (défaut) : métadonnées et FORMES de valeur seulement (motifs A/a/9) - aucune valeur réelle ne quitte jamais EBX. SAMPLE_VALUES : optionnel, les llmSampleSize valeurs distinctes les plus fréquentes de chaque colonne mappée sont aussi envoyées - à n'activer que pour un projet sans colonne sensible.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="NONE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">None: metadata and statistics only, not even value shapes</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Aucun : métadonnées et statistiques seulement, pas même la forme des valeurs</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="SHAPES_ONLY">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Shapes only (no real value)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Formes seulement (aucune valeur réelle)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="SAMPLE_VALUES">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">A sample of real distinct values</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Un échantillon de valeurs distinctes réelles</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="llmSampleSize" type="xs:int" minOccurs="0" maxOccurs="1" default="20">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Language model: sample size</osd:label>
                                        <osd:description>SAMPLE_VALUES mode only: how many of a column's most frequent distinct values are sent to the language model.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Modèle de langage : taille de l'échantillon</osd:label>
                                        <osd:description>Mode SAMPLE_VALUES seulement : combien des valeurs distinctes les plus fréquentes d'une colonne sont envoyées au modèle de langage.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="matchingTrigger" minOccurs="0" maxOccurs="1" default="MANUAL">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Matching trigger</osd:label>
                                        <osd:description>When the Match and Merge add-on matches the master records of this project. MANUAL (default, also when empty): matching runs when it is launched (after a load, or by hand); a master load never triggers one record-by-record matching. REALTIME: each record created or changed in the master is matched at once (the add-on's AFTER_SUBMISSION execution mode) - slows a mass load. Written on the matching policies by the next Configure matching.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Déclenchement du matching</osd:label>
                                        <osd:description>Quand l'add-on Match and Merge rapproche les enregistrements MDM de ce projet. MANUEL (défaut, aussi quand vide) : le matching tourne quand on le lance (après un chargement, ou à la main) ; un chargement MDM ne déclenche jamais de rapprochement enregistrement par enregistrement. TEMPS RÉEL : chaque enregistrement créé ou modifié dans le MDM est rapproché aussitôt (mode d'exécution AFTER_SUBMISSION de l'add-on) - ralentit un chargement en masse. Écrit sur les politiques de matching par le prochain Configure matching.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="MANUAL">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Manual: matching runs when it is launched</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Manuel : le matching tourne quand on le lance</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="REALTIME">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Real time: each master record created or changed is matched at once</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Temps réel : chaque enregistrement MDM créé ou modifié est rapproché aussitôt</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="intakeState" minOccurs="0" maxOccurs="1" default="OFF">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Automatic intake</osd:label>
                                        <osd:description>OFF (default, also when empty): the pipeline runs only when somebody launches it. ON: a landing row at _status NEW starts, after a quiet period, one instance of the workflow MdmFactoryPipeline in incremental mode (one at a time per project). PAUSED: the engine stopped by itself (a threshold, a failed chain) or a person paused it - nothing starts until Resume. Can only be switched on after the first full load.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Prise en charge automatique</osd:label>
                                        <osd:description>DÉSACTIVÉE (défaut, aussi quand vide) : le pipeline ne tourne que lorsque quelqu'un le lance. ACTIVÉE : une ligne du landing à _status NEW lance, après une période calme, une instance du workflow MdmFactoryPipeline en mode incrémental (une seule à la fois par projet). EN PAUSE : le moteur s'est arrêté seul (un seuil, une chaîne en échec) ou une personne l'a mis en pause - rien ne démarre avant la reprise. Activable seulement après le premier chargement complet.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="OFF">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Off: nothing starts by itself</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Désactivée : rien ne démarre tout seul</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="ON">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">On: new landing rows are processed automatically</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Activée : les nouvelles lignes du landing sont traitées automatiquement</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="PAUSED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Paused: switched on, but waiting for a person</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">En pause : activée, mais en attente d'une personne</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="intakePauseReason" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Automatic intake: pause reason</osd:label>
                                        <osd:description>Why intakeState is PAUSED (e.g. &quot;stopped: 6 % of the rows held back&quot;); empty otherwise.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Prise en charge automatique : motif de la pause</osd:label>
                                        <osd:description>Pourquoi intakeState vaut PAUSED (ex. « arrêtée : 6 % des lignes retenues ») ; vide sinon.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="500"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="intakeEnabledBy" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Automatic intake: switched on by</osd:label>
                                        <osd:description>User id of whoever switched the intake on. The workflow gate (workflow.PipelineLauncher) lets the engine run a chain as this user, and only while this user still holds the pipeline role.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Prise en charge automatique : activée par</osd:label>
                                        <osd:description>Identifiant de la personne qui a activé la prise en charge. La barrière du workflow (workflow.PipelineLauncher) laisse le moteur lancer une chaîne sous cette identité, et seulement tant qu'elle détient le rôle du pipeline.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="intakeEnabledAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Automatic intake: switched on at</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Prise en charge automatique : activée le</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="intakeReviewRejects" type="xs:boolean" minOccurs="0" maxOccurs="1" default="true">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Automatic intake: review the rows held back</osd:label>
                                        <osd:description>When a chain ends with rows held back (transfer rejects), open the non-blocking review task MdmFactoryRejectReview for the data steward. Empty counts as true.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Prise en charge automatique : revoir les lignes retenues</osd:label>
                                        <osd:description>Quand une chaîne se termine avec des lignes retenues (rejets de transfert), ouvrir la tâche de revue non bloquante MdmFactoryRejectReview pour le data steward. Vide vaut vrai.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="intakeStopRejectPercent" type="xs:int" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Automatic intake: stop at (% held back)</osd:label>
                                        <osd:description>Empty: never stop. Otherwise 1-100: a chain whose staging load held back AT LEAST this percentage of the rows it read stops at staging (nothing reaches the master) and the intake is paused.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Prise en charge automatique : arrêt à partir de (% retenu)</osd:label>
                                        <osd:description>Vide : ne jamais s'arrêter. Sinon 1-100 : une chaîne dont le chargement du staging a retenu AU MOINS ce pourcentage des lignes lues s'arrête au staging (rien n'atteint le MDM) et la prise en charge est mise en pause.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="accelSpecification" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Need (Centralisation)</osd:label>
                                        <osd:description>CENTRALISATION only: the need of the project in the words of the person, kept on the project so that it exists with or without a pack; it is sent to the language model, fenced as data.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Besoin (Centralisation)</osd:label>
                                        <osd:description>CENTRALISATION seulement : le besoin du projet dans les mots de la personne, gardé sur le projet pour exister avec ou sans pack ; il est envoyé au modèle de langage, encadré comme donnée.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="20000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="accelBlankStart" type="xs:boolean" minOccurs="0" maxOccurs="1" default="false">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Started without a pack</osd:label>
                                        <osd:description>CENTRALISATION only: true when the person chose &quot;Skip the packs, start blank&quot;; the language model then proposes the whole model from the need.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Démarré sans pack</osd:label>
                                        <osd:description>CENTRALISATION seulement : vrai quand la personne a choisi de démarrer sans pack ; le modèle de langage propose alors tout le modèle à partir du besoin.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="domainDataspace" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Domain dataspace</osd:label>
                                        <osd:description>CENTRALISATION only: the dataspace the generation created for the domain (a child of the reference dataspace); empty until generated.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dataspace du domaine</osd:label>
                                        <osd:description>CENTRALISATION seulement : le dataspace créé par la génération pour le domaine (enfant du dataspace de référence) ; vide avant la génération.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="domainDataset" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Domain dataset</osd:label>
                                        <osd:description>CENTRALISATION only: the dataset of the generated domain; empty until generated.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dataset du domaine</osd:label>
                                        <osd:description>CENTRALISATION seulement : le dataset du domaine généré ; vide avant la génération.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="domainModel" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Domain data model</osd:label>
                                        <osd:description>CENTRALISATION only: the published data model of the generated domain; empty until generated.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Modèle de données du domaine</osd:label>
                                        <osd:description>CENTRALISATION seulement : le modèle de données publié du domaine généré ; vide avant la génération.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="sources" type="xs:string" minOccurs="0" maxOccurs="0">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Sources</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Sources</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:association>
                                            <tableRefInverse>
                                                <fieldToSource>/root/ProjectSource/project</fieldToSource>
                                            </tableRefInverse>
                                        </osd:association>
                                        <osd:defaultView>
                                            <displayMode>tab</displayMode>
                                            <tabularView>
                                                <column>/sourceSystem</column>
                                                <column>/catalogSource</column>
                                                <column>/connector</column>
                                                <column>/trustRank</column>
                                                <column>/status</column>
                                                <initialQueryEnabled>true</initialQueryEnabled>
                                            </tabularView>
                                        </osd:defaultView>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="entities" type="xs:string" minOccurs="0" maxOccurs="0">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Staging entities</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Entités du staging</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:association>
                                            <tableRefInverse>
                                                <fieldToSource>/root/StagingEntity/project</fieldToSource>
                                            </tableRefInverse>
                                        </osd:association>
                                        <osd:defaultView>
                                            <displayMode>tab</displayMode>
                                            <tabularView>
                                                <column>/name</column>
                                                <column>/targetTable</column>
                                                <column>/origin</column>
                                                <column>/status</column>
                                                <initialQueryEnabled>true</initialQueryEnabled>
                                            </tabularView>
                                        </osd:defaultView>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="steps" type="xs:string" minOccurs="0" maxOccurs="0">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Pipeline</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Pipeline</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:association>
                                            <tableRefInverse>
                                                <fieldToSource>/root/PipelineStep/project</fieldToSource>
                                            </tableRefInverse>
                                        </osd:association>
                                        <osd:defaultView>
                                            <displayMode>tab</displayMode>
                                            <tabularView>
                                                <column>/step</column>
                                                <column>/scope</column>
                                                <column>/status</column>
                                                <column>/endedAt</column>
                                                <column>/message</column>
                                                <initialQueryEnabled>true</initialQueryEnabled>
                                            </tabularView>
                                        </osd:defaultView>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="agentRuns" type="xs:string" minOccurs="0" maxOccurs="0">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Agent runs</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Exécutions de l'agent</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:association>
                                            <tableRefInverse>
                                                <fieldToSource>/root/AgentRun/project</fieldToSource>
                                            </tableRefInverse>
                                        </osd:association>
                                        <osd:defaultView>
                                            <displayMode>tab</displayMode>
                                            <tabularView>
                                                <column>/phase</column>
                                                <column>/status</column>
                                                <column>/steps</column>
                                                <column>/startedAt</column>
                                                <initialQueryEnabled>true</initialQueryEnabled>
                                            </tabularView>
                                        </osd:defaultView>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="transferRejects" type="xs:string" minOccurs="0" maxOccurs="0">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Transfer rejects</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Rejets de transfert</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:association>
                                            <tableRefInverse>
                                                <fieldToSource>/root/TransferReject/project</fieldToSource>
                                            </tableRefInverse>
                                        </osd:association>
                                        <osd:defaultView>
                                            <displayMode>tab</displayMode>
                                            <tabularView>
                                                <column>/entity</column>
                                                <column>/sourceSystem</column>
                                                <column>/sourceId</column>
                                                <column>/stage</column>
                                                <column>/reasons</column>
                                                <column>/rejectedAt</column>
                                                <column>/resolved</column>
                                                <initialQueryEnabled>true</initialQueryEnabled>
                                            </tabularView>
                                        </osd:defaultView>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="ProjectSource" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Project sources</osd:label>
                            <osd:description>A source application taken into a project.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Sources du projet</osd:label>
                            <osd:description>Une application source retenue dans un projet.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/id </primaryKeys>
                                <defaultLabel>${./project} - ${./sourceSystem}</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" type="id" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="project" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Project</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Projet</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/Project</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="sourceSystem" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Source system code</osd:label>
                                        <osd:description>Written in _sourceSystem on every landed row and followed up to the golden record; also the name of the landing dataset.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Code du système source</osd:label>
                                        <osd:description>Écrit dans _sourceSystem sur chaque ligne du landing et suivi jusqu'au golden record ; aussi le nom du dataset de landing.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="40"/>
                                        <xs:pattern value="[A-Za-z][A-Za-z0-9_]*"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="catalogSource" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Catalog source</osd:label>
                                        <osd:description>Id of the source in the data catalog: its scanned assets, columns and profiles are what the landing is generated from.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Source du catalogue</osd:label>
                                        <osd:description>Identifiant de la source dans le catalogue de données : ses actifs, colonnes et profils scannés servent à générer le landing.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="connector" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Connector</osd:label>
                                        <osd:description>Id of the ebx-connectors connector the landing flows read from.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Connecteur</osd:label>
                                        <osd:description>Identifiant du connecteur ebx-connectors d'où lisent les flux de landing.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="schemaFilter" minOccurs="0" maxOccurs="unbounded">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Schemas</osd:label>
                                        <osd:description>Schemas of the catalog source that belong to this application (one scanned platform often hosts several: ERP_SOURCE and CRM_SOURCE of the same Snowflake account). Empty: all of them.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Schémas</osd:label>
                                        <osd:description>Schémas de la source du catalogue qui appartiennent à cette application (une plateforme scannée en héberge souvent plusieurs : ERP_SOURCE et CRM_SOURCE du même compte Snowflake). Vide : tous.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="trustRank" type="xs:int" minOccurs="0" maxOccurs="1" default="100">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Trust rank</osd:label>
                                        <osd:description>Lower wins: feeds the most-trusted-source order of the merge policy.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Rang de confiance</osd:label>
                                        <osd:description>Le plus petit l'emporte : alimente l'ordre des sources de confiance de la politique de fusion.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="landingModel" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Landing data model</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Modèle de données du landing</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="landingPublication" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Landing publication</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Publication du landing</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="landingDataset" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Landing dataset</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dataset de landing</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="status" minOccurs="1" maxOccurs="1" default="SELECTED">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Status</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Statut</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="SELECTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Selected</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Sélectionnée</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="GENERATED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Landing generated</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Landing généré</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="LOADED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Landing loaded</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Landing chargé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="FAILED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Failed</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">En échec</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="message" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Message</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Message</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="landingValidated" type="xs:boolean" minOccurs="0" maxOccurs="1" default="false">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Landing validated</osd:label>
                                        <osd:description>The person validated the tables and keys of this application at the Landing step. Cleared by any change of a tick or of a key.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Landing validé</osd:label>
                                        <osd:description>La personne a validé les tables et les clés de cette application à l'étape Landing. Effacé par tout changement de case ou de clé.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="landingValidatedBy" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Landing validated by</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Landing validé par</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="100"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="landingValidatedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Landing validated on</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Landing validé le</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="intakeQuietSeconds" type="xs:int" minOccurs="0" maxOccurs="1" default="60">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Intake: quiet period (s)</osd:label>
                                        <osd:description>Seconds without a new landing row before the chain starts (5-3600, default 60).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Prise en charge : période calme (s)</osd:label>
                                        <osd:description>Secondes sans nouvelle ligne du landing avant le démarrage de la chaîne (5-3600, défaut 60).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="intakeMaxWaitMinutes" type="xs:int" minOccurs="0" maxOccurs="1" default="10">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Intake: longest wait (min)</osd:label>
                                        <osd:description>A chain starts at the latest this many minutes after the first waiting row, however busy the source is (1-1440, default 10, not below the quiet period).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Prise en charge : attente maximale (min)</osd:label>
                                        <osd:description>Une chaîne démarre au plus tard ce nombre de minutes après la première ligne en attente, même si la source reste active (1-1440, défaut 10, pas sous la période calme).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="intakeMinRows" type="xs:int" minOccurs="0" maxOccurs="1" default="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Intake: minimum rows</osd:label>
                                        <osd:description>A chain is not started for fewer waiting rows than this (default 1); the longest wait and a batch-complete call still start it with at least one row.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Prise en charge : lignes minimum</osd:label>
                                        <osd:description>Aucune chaîne n'est lancée pour moins de lignes en attente que ce nombre (défaut 1) ; l'attente maximale et un appel « lot terminé » la lancent dès une ligne.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="intakeBatchSignal" type="xs:boolean" minOccurs="0" maxOccurs="1" default="false">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Intake: the application says when a batch is complete</osd:label>
                                        <osd:description>Informative: the application calls POST /projects/{code}/intake/{source}:complete when its batch is written, which starts the chain at once.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Prise en charge : l'application indique la fin d'un lot</osd:label>
                                        <osd:description>Informatif : l'application appelle POST /projects/{code}/intake/{source}:complete quand son lot est écrit, ce qui lance la chaîne aussitôt.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="tables" type="xs:string" minOccurs="0" maxOccurs="0">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Landing tables</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Tables du landing</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:association>
                                            <tableRefInverse>
                                                <fieldToSource>/root/LandingTable/projectSource</fieldToSource>
                                            </tableRefInverse>
                                        </osd:association>
                                        <osd:defaultView>
                                            <displayMode>tab</displayMode>
                                            <tabularView>
                                                <column>/sourceObject</column>
                                                <column>/tableName</column>
                                                <column>/columnCount</column>
                                                <column>/sourceRowCount</column>
                                                <column>/lastLoadRows</column>
                                                <column>/status</column>
                                                <initialQueryEnabled>true</initialQueryEnabled>
                                            </tabularView>
                                        </osd:defaultView>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="relations" type="xs:string" minOccurs="0" maxOccurs="0">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Relations</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Relations</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:association>
                                            <tableRefInverse>
                                                <fieldToSource>/root/LandingRelation/projectSource</fieldToSource>
                                            </tableRefInverse>
                                        </osd:association>
                                        <osd:defaultView>
                                            <displayMode>tab</displayMode>
                                            <tabularView>
                                                <column>/fromTable</column>
                                                <column>/toTable</column>
                                                <column>/cardinality</column>
                                                <column>/selfReference</column>
                                                <column>/origin</column>
                                                <column>/status</column>
                                                <initialQueryEnabled>true</initialQueryEnabled>
                                            </tabularView>
                                        </osd:defaultView>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="LandingTable" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Landing tables</osd:label>
                            <osd:description>One source object and the landing table generated for it.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Tables du landing</osd:label>
                            <osd:description>Un objet source et la table de landing générée pour lui.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/id </primaryKeys>
                                <defaultLabel>${./sourceObject}</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" type="id" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="projectSource" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Project source</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Source du projet</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/ProjectSource</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="catalogAsset" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Catalog asset</osd:label>
                                        <osd:description>Key of the scanned table in the data catalog (Asset.assetKey, source:qualifiedName).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Actif du catalogue</osd:label>
                                        <osd:description>Clé de la table scannée dans le catalogue de données (Asset.assetKey, source:nom qualifié).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="1000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="sourceObject" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Source object</osd:label>
                                        <osd:description>Qualified name at the source, e.g. DB.SCHEMA.TABLE.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Objet source</osd:label>
                                        <osd:description>Nom qualifié à la source, ex. DB.SCHEMA.TABLE.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="500"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="tableName" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Landing table</osd:label>
                                        <osd:description>Name of the generated EBX table.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Table du landing</osd:label>
                                        <osd:description>Nom de la table EBX générée.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="selected" type="xs:boolean" minOccurs="0" maxOccurs="1" default="true">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>In scope?</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dans le périmètre ?</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="columnCount" type="xs:int" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Columns</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Colonnes</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="sourceRowCount" type="xs:decimal" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Rows at the source</osd:label>
                                        <osd:description>As profiled by the catalog.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Lignes à la source</osd:label>
                                        <osd:description>Telles que profilées par le catalogue.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="inboundMapping" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Landing flow</osd:label>
                                        <osd:description>Id of the generated ebx-connectors mapping.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Flux de landing</osd:label>
                                        <osd:description>Identifiant du mapping ebx-connectors généré.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="status" minOccurs="1" maxOccurs="1" default="PROPOSED">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Status</osd:label>
                                        <osd:description>DRIFTED: the source no longer has the columns the landing was generated from.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Statut</osd:label>
                                        <osd:description>DRIFTED : la source n'a plus les colonnes d'après lesquelles le landing a été généré.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="PROPOSED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Proposed</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Proposée</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="GENERATED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Generated</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Générée</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="LOADED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Loaded</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Chargée</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="DRIFTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Source changed</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Source modifiée</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="FAILED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Failed</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">En échec</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="lastLoadId" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Last load</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dernier chargement</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="lastLoadAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Last loaded</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dernier chargement le</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="lastLoadRows" type="xs:decimal" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Rows of the last load</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Lignes du dernier chargement</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="message" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Message</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Message</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="keyConfidence" type="xs:int" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Key confidence (%)</osd:label>
                                        <osd:description>0-100, of whoever proposed the current source key (see the columns' &quot;Key proposed by&quot;).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Confiance de la clé (%)</osd:label>
                                        <osd:description>0-100, de qui a proposé la clé source actuelle (voir « Clé proposée par » des colonnes).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="keyRationale" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Key rationale</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Justification de la clé</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="changeColumn" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Change column</osd:label>
                                        <osd:description>Source column that carries the date or number of the last change of a row. Set, a reload reads only the rows changed since the last successful load; empty, the table is reloaded in full.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Colonne de changement</osd:label>
                                        <osd:description>Colonne source qui porte la date ou le numéro de la dernière modification d'une ligne. Renseignée, un rechargement ne lit que les lignes modifiées depuis le dernier chargement réussi ; vide, la table est rechargée en entier.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="changeColumnKind" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Change column kind</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Nature de la colonne de changement</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="TIMESTAMP">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Date or timestamp</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Date ou horodatage</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="MONOTONIC_ID">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Number that only grows</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Nombre qui ne fait que croître</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="ORDERED_STRING">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Text in plain order</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Texte en ordre simple</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="changeColumnLoaded" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Change column of the last load</osd:label>
                                        <osd:description>The change column the last successful load read through; when it differs from the current one the next load is a full refresh (the stored watermark belongs to the other column).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Colonne de changement du dernier chargement</osd:label>
                                        <osd:description>La colonne de changement par laquelle le dernier chargement réussi a lu ; si elle diffère de la colonne actuelle, le chargement suivant est un rechargement complet (le repère enregistré appartient à l'autre colonne).</osd:description>
                                    </xs:documentation>
