                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Referenced by</osd:label>
                                        <osd:description>Relations where this table is the parent: other tables point to it.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Référencée par</osd:label>
                                        <osd:description>Relations où cette table est parente : d'autres tables pointent vers elle.</osd:description>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:association>
                                            <tableRefInverse>
                                                <fieldToSource>/root/LandingRelation/toTable</fieldToSource>
                                            </tableRefInverse>
                                        </osd:association>
                                        <osd:defaultView>
                                            <displayMode>tab</displayMode>
                                            <tabularView>
                                                <column>/fromTable</column>
                                                <column>/fromColumns</column>
                                                <column>/toColumns</column>
                                                <column>/cardinality</column>
                                                <column>/origin</column>
                                                <column>/status</column>
                                                <initialQueryEnabled>true</initialQueryEnabled>
                                            </tabularView>
                                        </osd:defaultView>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="LandingColumn" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Landing columns</osd:label>
                            <osd:description>A source column as the landing was generated from it, with the profile the staging rules read.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Colonnes du landing</osd:label>
                            <osd:description>Une colonne source telle que le landing a été généré d'après elle, avec le profil que lisent les règles du staging.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/id </primaryKeys>
                                <defaultLabel>${./sourceColumn}</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" type="id" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="landingTable" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Landing table</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Table du landing</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/LandingTable</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="position" type="xs:int" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Position</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Position</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="sourceColumn" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Source column</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Colonne source</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="fieldName" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Landing field</osd:label>
                                        <osd:description>Name of the generated EBX field (a valid XML name).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Champ du landing</osd:label>
                                        <osd:description>Nom du champ EBX généré (un nom XML valide).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="sourceDataType" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Source data type</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Type à la source</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="sourceNullable" type="xs:boolean" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Nullable at the source?</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Nullable à la source ?</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="sourceKey" type="xs:boolean" minOccurs="0" maxOccurs="1" default="false">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Part of the source key?</osd:label>
                                        <osd:description>The source key columns build _sourceId, the identity of the row in its system. Proposed from the key declared at the source; many platforms declare none (Snowflake, files), then from a column that is unique and named like an identifier, and otherwise left to the user. Without any key column, _sourceId is the hash of the row.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dans la clé source ?</osd:label>
                                        <osd:description>Les colonnes de la clé source composent _sourceId, l'identité de la ligne dans son système. Proposées d'après la clé déclarée à la source ; beaucoup de plateformes n'en déclarent pas (Snowflake, fichiers), alors d'après une colonne unique au nom d'identifiant, et sinon laissées à l'utilisateur. Sans aucune colonne clé, _sourceId est l'empreinte de la ligne.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="sourceKeyOrigin" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Key proposed by</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Clé proposée par</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="RULE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Rule</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Règle</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="LLM">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Language model</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Modèle de langage</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="USER">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">User</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Utilisateur</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="SOURCE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Declared by the source</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Déclarée par la source</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="DEDUCED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Proposed by the language model during a deduced scan, confirmed by a person</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Proposée par le modèle de langage lors d'une déduction, confirmée par une personne</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="fillRate" type="xs:decimal" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Fill rate (%)</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Taux de remplissage (%)</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="distinctCount" type="xs:decimal" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Distinct values</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Valeurs distinctes</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="maxLength" type="xs:int" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Longest value</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Plus longue valeur</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="inferredType" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Inferred type</osd:label>
                                        <osd:description>What the values really are, whatever the source declares.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Type déduit</osd:label>
                                        <osd:description>Ce que les valeurs sont vraiment, quoi que déclare la source.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="STRING">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Text</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Texte</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="INTEGER">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Integer</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Entier</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="DECIMAL">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Decimal</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Décimal</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="BOOLEAN">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Boolean</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Booléen</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="DATE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Date</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Date</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="TIMESTAMP">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Date and time</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Date et heure</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="tags" minOccurs="0" maxOccurs="unbounded">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Catalog tags</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Étiquettes du catalogue</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="SourceDrift" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Source drifts</osd:label>
                            <osd:description>A schema change of a source since its landing was generated, waiting for a decision or decided.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Dérives de source</osd:label>
                            <osd:description>Un changement de schéma d'une source depuis la génération de son landing, en attente de décision ou décidé.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/id </primaryKeys>
                                <defaultLabel>${./kind} ${./sourceColumn}</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" type="id" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="project" type="xs:string" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Project</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Projet</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/Project</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="landingTable" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Landing table</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Table du landing</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/LandingTable</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="kind" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Change</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Changement</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="ADDED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Column added</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Colonne ajoutée</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="REMOVED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Column removed</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Colonne supprimée</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="RETYPED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Type changed</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Type changé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="sourceColumn" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Source column</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Colonne source</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="fieldName" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Landing field</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Champ du landing</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="oldType" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Type before</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Type avant</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="newType" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Type now</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Type maintenant</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="newDataType" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Normalised type now</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Type normalisé maintenant</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="sourceKey" type="xs:boolean" minOccurs="0" maxOccurs="1" default="false">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Part of the source key?</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dans la clé source ?</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="signature" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Signature</osd:label>
                                        <osd:description>Kind, column and new type: a rescan never records the same change twice.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Signature</osd:label>
                                        <osd:description>Type de changement, colonne et nouveau type : une nouvelle analyse n'enregistre jamais deux fois le même changement.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="400"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="landingChange" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Landing change</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Changement du landing</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="stagingChange" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Staging change</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Changement du staging</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="mappingChange" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Mapping change</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Changement du mapping</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="operations" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Model operations (JSON)</osd:label>
                                        <osd:description>The operations_json given to apply_data_model_patch on the landing model when the change is applied; [] when the model does not change.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Opérations du modèle (JSON)</osd:label>
                                        <osd:description>Les operations_json passées à apply_data_model_patch sur le modèle du landing quand le changement est appliqué ; [] quand le modèle ne change pas.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="20000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="tableStatusBefore" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Table status before</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Statut de la table avant</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="status" minOccurs="1" maxOccurs="1" default="PROPOSED">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Status</osd:label>
                                        <osd:description>A steward accepts or rejects; a designer applies an accepted change. Nothing is applied without a decision.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Statut</osd:label>
                                        <osd:description>Un steward accepte ou refuse ; un designer applique un changement accepté. Rien n'est appliqué sans décision.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="PROPOSED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Proposed</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Proposé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="ACCEPTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Accepted</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Accepté</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="REJECTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Rejected</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Refusé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="APPLIED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Applied</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Appliqué</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="FAILED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Apply failed</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Échec de l'application</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="detectedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Detected</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Détectée le</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="decidedBy" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Decided by</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Décidée par</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="decidedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Decided</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Décidée le</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="appliedBy" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Applied by</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Appliquée par</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="appliedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Applied</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Appliquée le</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="applyMessage" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Apply message</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Message d'application</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="LandingRelation" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Landing relations</osd:label>
                            <osd:description>A foreign key from one source object to another: proposed from the column names by RelationRule, or declared at the source. The landing carries it as data only - never as an EBX constraint, since a landing must never refuse what the source sends.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Relations du landing</osd:label>
                            <osd:description>Une clé étrangère d'un objet source vers un autre : proposée d'après les noms de colonnes par RelationRule, ou déclarée à la source. Le landing la porte comme donnée seulement - jamais comme contrainte EBX, un landing ne devant jamais refuser ce que la source envoie.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/id </primaryKeys>
                                <defaultLabel>${./fromTable} -&gt; ${./toTable}</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" type="id" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="projectSource" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Project source</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Source du projet</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/ProjectSource</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="fromTable" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>From table (child)</osd:label>
                                        <osd:description>The landing table that holds the reference: its columns point to another table.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Table source (enfant)</osd:label>
                                        <osd:description>La table du landing qui porte la référence : ses colonnes pointent vers une autre table.</osd:description>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/LandingTable</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="fromColumns" minOccurs="1" maxOccurs="unbounded">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>From columns</osd:label>
                                        <osd:description>Source column names of the child table that carry the reference, in key order.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Colonnes source</osd:label>
                                        <osd:description>Noms des colonnes source de la table enfant qui portent la référence, dans l'ordre de la clé.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="toTable" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>To table (parent)</osd:label>
                                        <osd:description>The landing table the reference points to.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Table cible (parente)</osd:label>
                                        <osd:description>La table du landing vers laquelle pointe la référence.</osd:description>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/LandingTable</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="toColumns" minOccurs="1" maxOccurs="unbounded">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>To columns</osd:label>
                                        <osd:description>Source column names of the parent table (its key), in the same order as fromColumns.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Colonnes cibles</osd:label>
                                        <osd:description>Noms des colonnes source de la table parente (sa clé), dans le même ordre que fromColumns.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="cardinality" minOccurs="1" maxOccurs="1" default="MANY_TO_ONE">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Cardinality</osd:label>
                                        <osd:description>MANY_TO_ONE unless a value check (or a declared key) shows the child columns are themselves unique.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Cardinalité</osd:label>
                                        <osd:description>MANY_TO_ONE, sauf si un contrôle des valeurs (ou une clé déclarée) montre que les colonnes enfant sont elles-mêmes uniques.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="MANY_TO_ONE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Many to one</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Plusieurs vers un</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="ONE_TO_ONE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">One to one</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Un vers un</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="selfReference" type="xs:boolean" minOccurs="0" maxOccurs="1" default="false">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Self reference?</osd:label>
                                        <osd:description>The parent and the child are the same table, e.g. ACCOUNT.PARENT_ACCOUNT_ID -&gt; ACCOUNT.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Référence sur elle-même ?</osd:label>
                                        <osd:description>La table parente et la table enfant sont la même, ex. ACCOUNT.PARENT_ACCOUNT_ID -&gt; ACCOUNT.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="origin" minOccurs="1" maxOccurs="1" default="USER">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Origin</osd:label>
                                        <osd:description>Who proposed this relation: a deterministic rule, the language model, or a person.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Origine</osd:label>
                                        <osd:description>Qui a proposé la relation : une règle déterministe, le modèle de langage ou une personne.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="RULE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Rule</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Règle</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="LLM">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Language model</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Modèle de langage</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="USER">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">User</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Utilisateur</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="DECLARED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Declared at the source</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Déclarée à la source</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="confidence" type="xs:int" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Confidence (%)</osd:label>
                                        <osd:description>0 to 100. Empty for a line entered by a person.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Confiance (%)</osd:label>
                                        <osd:description>De 0 à 100. Vide pour une ligne saisie par une personne.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="rationale" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Rationale</osd:label>
                                        <osd:description>Why it was proposed: the rule that fired, or the explanation given by the model.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Justification</osd:label>
                                        <osd:description>Pourquoi la proposition a été faite : la règle déclenchée, ou l'explication donnée par le modèle.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="status" minOccurs="1" maxOccurs="1" default="PROPOSED">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Status</osd:label>
                                        <osd:description>Nothing is generated from a line that is not accepted.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Statut</osd:label>
                                        <osd:description>Rien n'est généré depuis une ligne qui n'est pas acceptée.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="PROPOSED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Proposed</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Proposé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="ACCEPTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Accepted</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Accepté</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="REJECTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Rejected</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Refusé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="APPLIED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Applied</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Appliqué</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="checkedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Checked</osd:label>
                                        <osd:description>When the value check below last ran.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Vérifiée le</osd:label>
                                        <osd:description>Date du dernier contrôle des valeurs ci-dessous.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="childValues" type="xs:decimal" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Child values</osd:label>
                                        <osd:description>Distinct non-null values of the child columns, at the last check.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Valeurs enfant</osd:label>
                                        <osd:description>Valeurs distinctes non nulles des colonnes enfant, au dernier contrôle.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="orphanValues" type="xs:decimal" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Orphan values</osd:label>
                                        <osd:description>Of those, how many have no matching row in the parent table.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Valeurs orphelines</osd:label>
                                        <osd:description>Parmi elles, combien n'ont pas de ligne correspondante dans la table parente.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="message" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Message</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Message</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="StagingEntity" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Staging entities</osd:label>
                            <osd:description>A business entity of the staging zone, fed by one or several landing tables.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Entités du staging</osd:label>
                            <osd:description>Une entité métier de la zone de staging, alimentée par une ou plusieurs tables du landing.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/id </primaryKeys>
                                <defaultLabel>${./name}</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" type="id" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="project" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Project</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Projet</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/Project</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="name" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Name</osd:label>
                                        <osd:description>Name of the staging table.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Nom</osd:label>
                                        <osd:description>Nom de la table de staging.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                        <xs:pattern value="[A-Za-z][A-Za-z0-9_]*"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="label" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Label</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Libellé</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="targetTable" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Master table</osd:label>
                                        <osd:description>Path of the table of the master model this entity feeds, e.g. /root/Companies.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Table MDM</osd:label>
                                        <osd:description>Chemin de la table du modèle MDM que cette entité alimente, ex. /root/Companies.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="memberEntities" type="xs:string" minOccurs="0" maxOccurs="unbounded">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Unified entities</osd:label>
                                        <osd:description>The rule-proposed entities this canonical (language-model) entity unifies; empty for an entity that comes from one landing table. Structured, unlike the rationale text: StagingLlmSuggester writes it directly for a new canonical entity and reads it back for an existing one.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Entités unifiées</osd:label>
                                        <osd:description>Les entités proposées par les règles que cette entité canonique (modèle de langage) unifie ; vide pour une entité issue d'une seule table de landing. Structuré, à la différence du texte de justification : StagingLlmSuggester l'écrit directement pour une nouvelle entité canonique et le relit pour une existante.</osd:description>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/StagingEntity</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="origin" minOccurs="1" maxOccurs="1" default="USER">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Origin</osd:label>
                                        <osd:description>Who proposed this entity: a deterministic rule, the language model, or a person.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Origine</osd:label>
                                        <osd:description>Qui a proposé l'entité : une règle déterministe, le modèle de langage ou une personne.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="RULE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Rule</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Règle</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="LLM">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Language model</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Modèle de langage</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="USER">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">User</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Utilisateur</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="confidence" type="xs:int" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Confidence (%)</osd:label>
                                        <osd:description>0 to 100. Empty for a line entered by a person.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Confiance (%)</osd:label>
                                        <osd:description>De 0 à 100. Vide pour une ligne saisie par une personne.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="rationale" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Rationale</osd:label>
                                        <osd:description>Why it was proposed: the rule that fired, or the explanation given by the model.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Justification</osd:label>
                                        <osd:description>Pourquoi la proposition a été faite : la règle déclenchée, ou l'explication donnée par le modèle.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="status" minOccurs="1" maxOccurs="1" default="PROPOSED">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Status</osd:label>
                                        <osd:description>Nothing is generated from a line that is not accepted.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Statut</osd:label>
                                        <osd:description>Rien n'est généré depuis une ligne qui n'est pas acceptée.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="PROPOSED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Proposed</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Proposé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="ACCEPTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Accepted</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Accepté</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="REJECTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Rejected</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Refusé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="APPLIED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Applied</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Appliqué</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="lastLoadAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Last transfer</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dernier transfert</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="lastLoadRead" type="xs:decimal" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Rows read</osd:label>
                                        <osd:description>Landing rows read across every feed of this entity, at the last transfer.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Lignes lues</osd:label>
                                        <osd:description>Lignes du landing lues sur l'ensemble des flux de cette entité, au dernier transfert.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="lastLoadWritten" type="xs:decimal" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Rows written</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Lignes écrites</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="lastLoadSkipped" type="xs:decimal" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Rows skipped</osd:label>
                                        <osd:description>Not written and not rejected: an unresolved deferred reference on an already-written row.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Lignes ignorées</osd:label>
                                        <osd:description>Ni écrites ni rejetées : une référence différée non résolue sur une ligne déjà écrite.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="lastLoadRejected" type="xs:decimal" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Rows rejected</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Lignes rejetées</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="lastLoadUnchanged" type="xs:decimal" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Rows unchanged</osd:label>
                                        <osd:description>Read (scope new: its landing status said NEW), but its content hash matched the staging row already there: not written, only the landing row marked STAGED.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Lignes inchangées</osd:label>
                                        <osd:description>Lues (portée new : leur statut de landing valait NEW), mais leur empreinte de contenu correspondait déjà à la ligne de staging existante : non écrites, seule la ligne de landing est marquée STAGED.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="lastLoadMessage" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Last transfer message</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Message du dernier transfert</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="attributes" type="xs:string" minOccurs="0" maxOccurs="0">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Attributes</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Attributs</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:association>
                                            <tableRefInverse>
                                                <fieldToSource>/root/StagingAttribute/entity</fieldToSource>
                                            </tableRefInverse>
                                        </osd:association>
                                        <osd:defaultView>
                                            <displayMode>tab</displayMode>
                                            <tabularView>
                                                <column>/name</column>
                                                <column>/dataType</column>
                                                <column>/maxLength</column>
                                                <column>/mandatory</column>
                                                <column>/businessKey</column>
                                                <column>/derivedFrom</column>
                                                <column>/derivation</column>
                                                <column>/origin</column>
                                                <column>/status</column>
                                                <initialQueryEnabled>true</initialQueryEnabled>
                                            </tabularView>
                                        </osd:defaultView>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="feeds" type="xs:string" minOccurs="0" maxOccurs="0">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Transfer feeds</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Flux de transfert</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:association>
                                            <tableRefInverse>
                                                <fieldToSource>/root/TransferFeed/entity</fieldToSource>
                                            </tableRefInverse>
                                        </osd:association>
                                        <osd:defaultView>
                                            <displayMode>tab</displayMode>
                                            <tabularView>
                                                <column>/landingTable</column>
                                                <column>/parentFeed</column>
                                                <column>/collectionPath</column>
                                                <column>/origin</column>
                                                <column>/status</column>
                                                <initialQueryEnabled>true</initialQueryEnabled>
                                            </tabularView>
                                        </osd:defaultView>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="qualityRules" type="xs:string" minOccurs="0" maxOccurs="0">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Quality rules</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Règles de qualité</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:association>
                                            <tableRefInverse>
                                                <fieldToSource>/root/QualityRule/entity</fieldToSource>
                                            </tableRefInverse>
                                        </osd:association>
                                        <osd:defaultView>
                                            <displayMode>tab</displayMode>
                                            <tabularView>
                                                <column>/attribute</column>
                                                <column>/kind</column>
                                                <column>/severity</column>
                                                <column>/origin</column>
                                                <column>/confidence</column>
                                                <column>/status</column>
                                                <initialQueryEnabled>true</initialQueryEnabled>
                                            </tabularView>
                                        </osd:defaultView>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="capabilitySuggestions" type="xs:string" minOccurs="0" maxOccurs="0">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Capability suggestions</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Suggestions de capacité</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:association>
                                            <tableRefInverse>
                                                <fieldToSource>/root/CapabilitySuggestion/entity</fieldToSource>
                                            </tableRefInverse>
                                        </osd:association>
                                        <osd:defaultView>
                                            <displayMode>tab</displayMode>
                                            <tabularView>
                                                <column>/attribute</column>
                                                <column>/nature</column>
                                                <column>/zone</column>
                                                <column>/targetLibrary</column>
                                                <column>/connectorId</column>
                                                <column>/origin</column>
                                                <column>/status</column>
                                                <initialQueryEnabled>true</initialQueryEnabled>
                                            </tabularView>
                                        </osd:defaultView>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="matchPlans" type="xs:string" minOccurs="0" maxOccurs="0">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Matching</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Rapprochement</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:association>
                                            <tableRefInverse>
                                                <fieldToSource>/root/MatchPlan/entity</fieldToSource>
                                            </tableRefInverse>
                                        </osd:association>
                                        <osd:defaultView>
                                            <displayMode>tab</displayMode>
                                            <tabularView>
                                                <column>/matchingPolicy</column>
                                                <column>/mergePolicy</column>
                                                <column>/status</column>
                                                <initialQueryEnabled>true</initialQueryEnabled>
                                            </tabularView>
                                        </osd:defaultView>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="rejects" type="xs:string" minOccurs="0" maxOccurs="0">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Transfer rejects</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Rejets de transfert</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:association>
                                            <tableRefInverse>
                                                <fieldToSource>/root/TransferReject/entity</fieldToSource>
                                            </tableRefInverse>
                                        </osd:association>
                                        <osd:defaultView>
                                            <displayMode>tab</displayMode>
                                            <tabularView>
                                                <column>/sourceSystem</column>
                                                <column>/sourceId</column>
                                                <column>/stage</column>
                                                <column>/reasons</column>
                                                <column>/rejectedAt</column>
                                                <column>/resolved</column>
                                                <initialQueryEnabled>true</initialQueryEnabled>
                                            </tabularView>
                                        </osd:defaultView>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="StagingAttribute" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Staging attributes</osd:label>
                            <osd:description>An attribute of a staging entity: typed and constrained, unlike the landing columns that feed it.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Attributs du staging</osd:label>
                            <osd:description>Un attribut d'une entité du staging : typé et contraint, à la différence des colonnes du landing qui l'alimentent.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/id </primaryKeys>
                                <defaultLabel>${./name}</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" type="id" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="entity" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Entity</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Entité</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/StagingEntity</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="name" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Name</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Nom</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                        <xs:pattern value="[A-Za-z][A-Za-z0-9_]*"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="label" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Label</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Libellé</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="dataType" minOccurs="1" maxOccurs="1" default="STRING">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Data type</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Type de donnée</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="STRING">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Text</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Texte</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="INTEGER">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Integer</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Entier</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="DECIMAL">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Decimal</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Décimal</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="BOOLEAN">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Boolean</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Booléen</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="DATE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Date</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Date</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="TIMESTAMP">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Date and time</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Date et heure</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="maxLength" type="xs:int" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Maximum length</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Longueur maximale</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="mandatory" type="xs:boolean" minOccurs="0" maxOccurs="1" default="false">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Mandatory?</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Obligatoire ?</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="businessKey" type="xs:boolean" minOccurs="0" maxOccurs="1" default="false">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Part of the business key?</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dans la clé métier ?</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="primaryKey" type="xs:boolean" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Part of the staging primary key?</osd:label>
                                        <osd:description>The technical identity of a staging row (sourceSystem + sourceId), not the source's own key: set on those two technical attributes only, never on a plain business column. Left empty (no default) on purpose, unlike businessKey/mandatory/enumerated: it lets a row written before this field existed be told apart from one where the factory explicitly decided false.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dans la clé primaire du staging ?</osd:label>
                                        <osd:description>L'identité technique d'une ligne de staging (sourceSystem + sourceId), pas la clé propre de la source : posé sur ces deux attributs techniques seulement, jamais sur une colonne métier. Laissé vide (pas de valeur par défaut) volontairement, à la différence de businessKey/mandatory/enumerated : cela permet de distinguer une ligne écrite avant l'existence de ce champ d'une ligne où la factory a explicitement décidé false.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="enumerated" type="xs:boolean" minOccurs="0" maxOccurs="1" default="false">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Closed list of values?</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Liste fermée de valeurs ?</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="referenceEntity" type="xs:string" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Refers to</osd:label>
                                        <osd:description>Set when the attribute is a foreign key to another entity.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Référence</osd:label>
                                        <osd:description>Renseigné quand l'attribut est une clé étrangère vers une autre entité.</osd:description>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/StagingEntity</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="fromRelation" type="xs:string" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Origin relation</osd:label>
                                        <osd:description>The LandingRelation this reference was deduced from; empty when a person or the model set the reference directly. A real foreign key, not text: the review screen reads it to require that relation accepted too, instead of guessing at the rationale text.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Relation d'origine</osd:label>
                                        <osd:description>La LandingRelation dont cette référence a été déduite ; vide quand une personne ou le modèle a posé la référence directement. Une vraie clé étrangère, pas du texte : l'écran de revue la lit pour exiger que cette relation soit aussi acceptée, au lieu de deviner d'après le texte de la justification.</osd:description>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/LandingRelation</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="targetPath" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Master field</osd:label>
                                        <osd:description>Path of the field in the master table, relative to the record.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Champ MDM</osd:label>
                                        <osd:description>Chemin du champ dans la table MDM, relatif à l'enregistrement.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="derivedFrom" type="xs:string" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Derived from</osd:label>
                                        <osd:description>Set when this attribute is computed from another attribute of the same entity (e.g. a matching key), instead of being fed by a mapping.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dérivé de</osd:label>
                                        <osd:description>Renseigné quand cet attribut est calculé depuis un autre attribut de la même entité (par exemple une clé de rapprochement), au lieu d'être alimenté par un mapping.</osd:description>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/StagingAttribute</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="derivation" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Derivation</osd:label>
                                        <osd:description>How this attribute is computed from derivedFrom. Empty for an ordinary attribute.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dérivation</osd:label>
                                        <osd:description>Comment cet attribut est calculé depuis derivedFrom. Vide pour un attribut ordinaire.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="FOLD_KEY">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Matching key (no accents, no case)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Clé de rapprochement (sans accents ni casse)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="VALID_VALUE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Valid value (the source value when it passes its own quality rules, else empty)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Valeur valide (la valeur source quand elle respecte ses propres règles qualité, sinon vide)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="SCRIPT">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Computed by a script function</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Calculé par une fonction de script</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="CHILD_KEYS">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Keys of the child records (one exact key per child, built from child attributes)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Clés des enregistrements enfants (une clé exacte par enfant, construite depuis des attributs de l'enfant)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="derivationArgument" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Derivation argument</osd:label>
                                        <osd:description>CHILD_KEYS only: a JSON object {&quot;child&quot;:&quot;&lt;child entity&gt;&quot;,&quot;fields&quot;:[&quot;&lt;child attribute&gt;&quot;,...]} (the key of one child record is those attributes, folded and joined; optional &quot;required&quot;:[...] = the attributes that must be non-empty, all of them when absent; optional &quot;reference&quot;:&quot;&lt;child attribute&gt;&quot; = the child attribute that refers to this entity when it has several; optional &quot;maxTokens&quot;:N = a cap on the number of keys kept). The text length of the attribute (maxLength) caps the value. Empty for every other derivation.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Argument de la dérivation</osd:label>
                                        <osd:description>CHILD_KEYS seulement : un objet JSON {&quot;child&quot;:&quot;&lt;entité enfant&gt;&quot;,&quot;fields&quot;:[&quot;&lt;attribut enfant&gt;&quot;,...]} (la clé d'un enregistrement enfant est ces attributs, repliés puis joints ; &quot;required&quot;:[...] facultatif = les attributs qui doivent être non vides, tous s'il est absent ; &quot;reference&quot;:&quot;&lt;attribut enfant&gt;&quot; facultatif = l'attribut enfant qui référence cette entité quand il y en a plusieurs ; &quot;maxTokens&quot;:N facultatif = un plafond du nombre de clés conservées). La longueur du texte de l'attribut (maxLength) plafonne la valeur. Vide pour toute autre dérivation.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="derivationLastRunAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Last computed</osd:label>
                                        <osd:description>CHILD_KEYS only: when the staging load last finished computing this attribute from the child records. Emptied by a load that changed rows without finishing, so that the next load recomputes it.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dernier calcul</osd:label>
                                        <osd:description>CHILD_KEYS seulement : quand le chargement du staging a fini de calculer cet attribut depuis les enregistrements enfants. Vidé par un chargement qui a modifié des lignes sans aller au bout, pour que le suivant le recalcule.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="derivationLastRunMessage" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Last computation</osd:label>
                                        <osd:description>CHILD_KEYS only: the counters of the last computation (children read, parents updated, keys dropped by the cap).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dernier calcul (détail)</osd:label>
                                        <osd:description>CHILD_KEYS seulement : les compteurs du dernier calcul (enfants lus, parents mis à jour, clés écartées par le plafond).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="500"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="origin" minOccurs="1" maxOccurs="1" default="USER">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Origin</osd:label>
                                        <osd:description>Who proposed this attribute: a deterministic rule, the language model, or a person.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Origine</osd:label>
                                        <osd:description>Qui a proposé l'attribut : une règle déterministe, le modèle de langage ou une personne.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="RULE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Rule</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Règle</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="LLM">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Language model</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Modèle de langage</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="USER">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">User</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Utilisateur</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="confidence" type="xs:int" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Confidence (%)</osd:label>
                                        <osd:description>0 to 100. Empty for a line entered by a person.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Confiance (%)</osd:label>
                                        <osd:description>De 0 à 100. Vide pour une ligne saisie par une personne.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="rationale" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Rationale</osd:label>
                                        <osd:description>Why it was proposed: the rule that fired, or the explanation given by the model.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Justification</osd:label>
                                        <osd:description>Pourquoi la proposition a été faite : la règle déclenchée, ou l'explication donnée par le modèle.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="status" minOccurs="1" maxOccurs="1" default="PROPOSED">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Status</osd:label>
                                        <osd:description>Nothing is generated from a line that is not accepted.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Statut</osd:label>
                                        <osd:description>Rien n'est généré depuis une ligne qui n'est pas acceptée.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="PROPOSED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Proposed</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Proposé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="ACCEPTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Accepted</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Accepté</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="REJECTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Rejected</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Refusé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="APPLIED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Applied</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Appliqué</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="mappings" type="xs:string" minOccurs="0" maxOccurs="0">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Mappings</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Mappings</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:association>
                                            <tableRefInverse>
                                                <fieldToSource>/root/AttributeMapping/attribute</fieldToSource>
                                            </tableRefInverse>
                                        </osd:association>
                                        <osd:defaultView>
                                            <displayMode>tab</displayMode>
                                            <tabularView>
                                                <column>/landingColumn</column>
                                                <column>/transformation</column>
                                                <column>/argument</column>
                                                <column>/origin</column>
                                                <column>/confidence</column>
                                                <column>/status</column>
                                                <initialQueryEnabled>true</initialQueryEnabled>
                                            </tabularView>
                                        </osd:defaultView>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="qualityRules" type="xs:string" minOccurs="0" maxOccurs="0">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Quality rules</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Règles de qualité</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:association>
                                            <tableRefInverse>
                                                <fieldToSource>/root/QualityRule/attribute</fieldToSource>
                                            </tableRefInverse>
                                        </osd:association>
                                        <osd:defaultView>
                                            <displayMode>tab</displayMode>
                                            <tabularView>
                                                <column>/kind</column>
                                                <column>/severity</column>
                                                <column>/origin</column>
                                                <column>/confidence</column>
                                                <column>/status</column>
                                                <initialQueryEnabled>true</initialQueryEnabled>
                                            </tabularView>
                                        </osd:defaultView>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="TransferFeed" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Transfer feeds</osd:label>
                            <osd:description>One node of a landing -&gt; staging mapping tree: a root feed reads a landing table into one target entity; a child feed reads that same row (or an element found in it) into a child entity.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Flux de transfert</osd:label>
                            <osd:description>Un nœud d'un arbre de mapping landing -&gt; staging : un flux racine lit une table du landing vers une entité cible ; un flux enfant lit cette même ligne (ou un élément qu'elle contient) vers une entité enfant.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/id </primaryKeys>
                                <defaultLabel>${./entity} &lt;- ${./landingTable}</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" type="id" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="entity" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Target entity</osd:label>
                                        <osd:description>The staging entity this feed writes.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Entité cible</osd:label>
                                        <osd:description>L'entité de staging que ce flux alimente.</osd:description>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/StagingEntity</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="landingTable" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Landing table</osd:label>
                                        <osd:description>The landing table read. A child feed names the SAME table as its parent when it reads the parent's own row (collectionPath empty).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Table du landing</osd:label>
                                        <osd:description>La table du landing lue. Un flux enfant nomme la MÊME table que son parent quand il lit la ligne de son parent (collectionPath vide).</osd:description>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/LandingTable</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="parentFeed" type="xs:string" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Parent feed</osd:label>
                                        <osd:description>Empty for a root feed. Set for a child feed: one child staging row (or several, see collectionPath) per parent row.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Flux parent</osd:label>
                                        <osd:description>Vide pour un flux racine. Renseigné pour un flux enfant : une ligne de staging enfant (ou plusieurs, voir collectionPath) par ligne parente.</osd:description>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/TransferFeed</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="collectionPath" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Collection path</osd:label>
                                        <osd:description>JSON path, in the landing row document, of the array/object holding the child elements. Empty: the parent row itself is the one element (the flat-source case) - landing rows are flat today, so this stays empty everywhere for now.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Chemin de la collection</osd:label>
                                        <osd:description>Chemin JSON, dans le document de la ligne de landing, du tableau/objet portant les éléments enfants. Vide : la ligne parente elle-même est l'unique élément (cas source plate) - les lignes de landing sont plates aujourd'hui, ce champ reste donc vide partout pour l'instant.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="parentLinkField" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Parent link field</osd:label>
                                        <osd:description>Child only, mandatory then: the staging field of the child entity that holds the parent's staging key (the &lt;attribute&gt;Ref field StagingModel.build generates for the child's referenceEntity attribute).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Champ de lien parent</osd:label>
                                        <osd:description>Enfant seulement, alors obligatoire : le champ de staging de l'entité enfant qui porte la clé de staging du parent (le champ &lt;attribut&gt;Ref que StagingModel.build génère pour l'attribut referenceEntity de l'enfant).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="sourceIdPipeline" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Source id pipeline</osd:label>
                                        <osd:description>How the child's sourceId is computed from the landing row document, Connectors pipeline syntax, e.g. concat(ID)|suffix(#MAIN). Empty on a root feed: the landing row's own _sourceId. Empty on a child feed: &lt;parent sourceId&gt;#&lt;position among its siblings&gt;.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Pipeline de l'identifiant source</osd:label>
                                        <osd:description>Comment le sourceId de l'enfant est calculé depuis le document de la ligne de landing, syntaxe de pipeline Connectors, ex. concat(ID)|suffix(#MAIN). Vide sur un flux racine : le _sourceId propre de la ligne de landing. Vide sur un flux enfant : &lt;sourceId du parent&gt;#&lt;position parmi ses frères&gt;.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="500"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="variant" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Variant</osd:label>
                                        <osd:description>Child feed only: the role of this child when one landing row holds several children of the same entity (e.g. MAILING, OTHER). Empty for the only child of its kind. When set and sourceIdPipeline is empty, the child's sourceId is &lt;parent sourceId&gt;#&lt;variant&gt;.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Variante</osd:label>
                                        <osd:description>Flux enfant seulement : le rôle de cet enfant quand une ligne de landing porte plusieurs enfants de la même entité (ex. MAILING, OTHER). Vide pour le seul enfant de son espèce. Renseigné et sourceIdPipeline vide : le sourceId de l'enfant est &lt;sourceId du parent&gt;#&lt;variante&gt;.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="origin" minOccurs="1" maxOccurs="1" default="USER">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Origin</osd:label>
                                        <osd:description>Who proposed this feed: a deterministic rule, the language model, or a person.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Origine</osd:label>
                                        <osd:description>Qui a proposé le flux : une règle déterministe, le modèle de langage ou une personne.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="RULE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Rule</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Règle</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="LLM">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Language model</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Modèle de langage</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="USER">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">User</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Utilisateur</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="confidence" type="xs:int" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Confidence (%)</osd:label>
                                        <osd:description>0 to 100. Empty for a line entered by a person.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Confiance (%)</osd:label>
                                        <osd:description>De 0 à 100. Vide pour une ligne saisie par une personne.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="rationale" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Rationale</osd:label>
                                        <osd:description>Why it was proposed: the rule that fired, or the explanation given by the model.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Justification</osd:label>
                                        <osd:description>Pourquoi la proposition a été faite : la règle déclenchée, ou l'explication donnée par le modèle.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="status" minOccurs="1" maxOccurs="1" default="PROPOSED">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Status</osd:label>
                                        <osd:description>Nothing is generated from a line that is not accepted.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Statut</osd:label>
                                        <osd:description>Rien n'est généré depuis une ligne qui n'est pas acceptée.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="PROPOSED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Proposed</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Proposé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="ACCEPTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Accepted</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Accepté</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="REJECTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Rejected</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Refusé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="APPLIED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Applied</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Appliqué</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="reviewComment" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Review comment</osd:label>
                                        <osd:description>Why this feed was rejected - entered by the reviewer, shown back on the Mapping matrix screen.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Commentaire de revue</osd:label>
                                        <osd:description>Pourquoi ce flux a été rejeté - saisi par le relecteur, réaffiché sur l'écran Matrice de mapping.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="childFeeds" type="xs:string" minOccurs="0" maxOccurs="0">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Child feeds</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Flux enfants</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:association>
                                            <tableRefInverse>
                                                <fieldToSource>/root/TransferFeed/parentFeed</fieldToSource>
                                            </tableRefInverse>
                                        </osd:association>
                                        <osd:defaultView>
                                            <displayMode>tab</displayMode>
                                            <tabularView>
                                                <column>/entity</column>
                                                <column>/landingTable</column>
                                                <column>/collectionPath</column>
                                                <column>/origin</column>
                                                <column>/status</column>
                                                <initialQueryEnabled>true</initialQueryEnabled>
                                            </tabularView>
                                        </osd:defaultView>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="mappings" type="xs:string" minOccurs="0" maxOccurs="0">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Mappings</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Mappings</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:association>
                                            <tableRefInverse>
                                                <fieldToSource>/root/AttributeMapping/feed</fieldToSource>
                                            </tableRefInverse>
                                        </osd:association>
                                        <osd:defaultView>
                                            <displayMode>tab</displayMode>
                                            <tabularView>
                                                <column>/attribute</column>
                                                <column>/landingColumn</column>
                                                <column>/pipeline</column>
                                                <column>/origin</column>
                                                <column>/status</column>
                                                <initialQueryEnabled>true</initialQueryEnabled>
                                            </tabularView>
                                        </osd:defaultView>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="AttributeMapping" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Attribute mappings</osd:label>
                            <osd:description>Which landing column feeds which staging attribute, and how the value is transformed on the way.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Mappings d'attributs</osd:label>
                            <osd:description>Quelle colonne du landing alimente quel attribut du staging, et comment la valeur est transformée en chemin.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/id </primaryKeys>
                                <defaultLabel>${./landingColumn} -&gt; ${./attribute}</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" type="id" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="attribute" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Staging attribute</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Attribut du staging</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/StagingAttribute</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="landingColumn" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Landing column</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Colonne du landing</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/LandingColumn</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="transformation" minOccurs="1" maxOccurs="1" default="TRIM">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Transformation</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Transformation</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="NONE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">As is</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Telle quelle</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="TRIM">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Trim</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Sans espaces autour</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="UPPER">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Upper case</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Majuscules</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="LOWER">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Lower case</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Minuscules</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="PARSE_DATE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Parse a date</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Lire une date</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="PARSE_DECIMAL">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Parse a number</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Lire un nombre</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="PARSE_BOOLEAN">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Parse a boolean</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Lire un booléen</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="TRANSCODE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Transcode</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Transcoder</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="CONSTANT">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Constant</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Constante</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="argument" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Argument</osd:label>
                                        <osd:description>The date pattern, the decimal separator, the transcoding as JSON ({&quot;M&quot;:&quot;MALE&quot;}), or the constant.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Argument</osd:label>
                                        <osd:description>Le motif de date, le séparateur décimal, le transcodage en JSON ({&quot;M&quot;:&quot;MALE&quot;}), ou la constante.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="500"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="feed" type="xs:string" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Feed</osd:label>
                                        <osd:description>The transfer feed this rule belongs to. Empty only for a row written before this lot (staging/suggest backfills it).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Flux</osd:label>
                                        <osd:description>Le flux de transfert auquel appartient cette règle. Vide seulement pour une ligne écrite avant ce lot (staging/suggest la complète).</osd:description>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/TransferFeed</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="pipeline" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Pipeline</osd:label>
                                        <osd:description>A Connectors rule pipeline (e.g. trim|upper). When non-empty it REPLACES transformation/argument entirely; the rule's sourcePath is landingColumn.fieldName and the pipeline may read OTHER columns of the same landing row through concat(...).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Pipeline</osd:label>
                                        <osd:description>Un pipeline de règle Connectors (ex. trim|upper). Non vide, il REMPLACE entièrement transformation/argument ; le sourcePath de la règle est landingColumn.fieldName et le pipeline peut lire D'AUTRES colonnes de la même ligne de landing via concat(...).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="origin" minOccurs="1" maxOccurs="1" default="USER">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Origin</osd:label>
                                        <osd:description>Who proposed this mapping: a deterministic rule, the language model, or a person.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Origine</osd:label>
                                        <osd:description>Qui a proposé le mapping : une règle déterministe, le modèle de langage ou une personne.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="RULE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Rule</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Règle</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="LLM">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Language model</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Modèle de langage</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="USER">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">User</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Utilisateur</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="confidence" type="xs:int" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Confidence (%)</osd:label>
                                        <osd:description>0 to 100. Empty for a line entered by a person.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Confiance (%)</osd:label>
                                        <osd:description>De 0 à 100. Vide pour une ligne saisie par une personne.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="rationale" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Rationale</osd:label>
                                        <osd:description>Why it was proposed: the rule that fired, or the explanation given by the model.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Justification</osd:label>
                                        <osd:description>Pourquoi la proposition a été faite : la règle déclenchée, ou l'explication donnée par le modèle.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="status" minOccurs="1" maxOccurs="1" default="PROPOSED">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Status</osd:label>
                                        <osd:description>Nothing is generated from a line that is not accepted.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Statut</osd:label>
                                        <osd:description>Rien n'est généré depuis une ligne qui n'est pas acceptée.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="PROPOSED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Proposed</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Proposé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="ACCEPTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Accepted</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Accepté</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="REJECTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Rejected</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Refusé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="APPLIED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Applied</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Appliqué</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="reviewComment" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Review comment</osd:label>
                                        <osd:description>Why this mapping was rejected - entered by the reviewer, shown back on the Mapping matrix screen.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Commentaire de revue</osd:label>
                                        <osd:description>Pourquoi ce mapping a été rejeté - saisi par le relecteur, réaffiché sur l'écran Matrice de mapping.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="alternativeTo" type="xs:string" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Alternative to</osd:label>
                                        <osd:description>Another AttributeMapping row this one is proposed to replace - empty for an ordinary mapping.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Alternative à</osd:label>
                                        <osd:description>Un autre mapping que celui-ci propose de remplacer - vide pour un mapping ordinaire.</osd:description>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/AttributeMapping</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="cleaningSteps" type="xs:string" minOccurs="0" maxOccurs="0">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Cleaning steps</osd:label>
                                        <osd:description>Pre-parse cleanup pipeline, run in position order on the raw landing text before this mapping's own transformation above.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Étapes de nettoyage</osd:label>
                                        <osd:description>Chaîne de nettoyage avant analyse, exécutée dans l'ordre des positions sur le texte brut du landing avant la transformation ci-dessus.</osd:description>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:association>
                                            <tableRefInverse>
                                                <fieldToSource>/root/MappingStep/mapping</fieldToSource>
                                            </tableRefInverse>
                                        </osd:association>
                                        <osd:defaultView>
                                            <displayMode>tab</displayMode>
                                            <tabularView>
                                                <column>/position</column>
                                                <column>/kind</column>
                                                <column>/argument</column>
                                                <column>/origin</column>
                                                <column>/confidence</column>
                                                <column>/status</column>
                                                <initialQueryEnabled>true</initialQueryEnabled>
                                            </tabularView>
                                        </osd:defaultView>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="MappingStep" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Mapping steps</osd:label>
                            <osd:description>One pre-parse cleanup step of one mapping's pipeline, reviewed and accepted independently of the mapping's own transformation.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Étapes de mapping</osd:label>
                            <osd:description>Une étape de nettoyage avant analyse, dans le pipeline d'un mapping, revue et acceptée indépendamment de la transformation propre du mapping.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/id </primaryKeys>
                                <defaultLabel>${./kind}</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" type="id" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="mapping" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Mapping</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Mapping</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/AttributeMapping</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="position" type="xs:int" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Position</osd:label>
                                        <osd:description>Execution order, ascending; this mapping's own transformation always runs after every step of the same mapping.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Position</osd:label>
                                        <osd:description>Ordre d'exécution, croissant ; la transformation propre du mapping s'exécute toujours après chaque étape du même mapping.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="kind" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Kind</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Nature</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="TRIM">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Trim</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Sans espaces autour</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="COLLAPSE_SPACES">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Collapse inner spaces</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Réduire les espaces internes</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="EMPTY_TO_NULL">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Empty-ish to null</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Valeur vide vers nul</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="UPPER">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Upper case</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Majuscules</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="LOWER">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Lower case</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Minuscules</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="STRIP_CHARS">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Strip characters</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Retirer des caractères</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="STRIP_ACCENTS">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Strip accents</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Retirer les accents</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="COUNTRY_TO_ISO2">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Country to ISO 3166-1 alpha-2</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Pays vers ISO 3166-1 alpha-2</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="CURRENCY_TO_ISO">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Currency to ISO 4217</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Devise vers ISO 4217</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="TRANSCODE_REFERENCE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Transcode against a reference table</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Transcoder vers un référentiel</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="NORMALISE_IDENTIFIER">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Normalise an identifier</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Normaliser un identifiant</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="TITLE_CASE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Title case</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Première lettre de chaque mot en majuscule</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="argument" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Argument</osd:label>
                                        <osd:description>Meaning depends on kind: the sentinel list for EMPTY_TO_NULL (pipe-delimited), the characters to strip for STRIP_CHARS/NORMALISE_IDENTIFIER, a JSON object naming the reference and, for a scoped one, the scope field for TRANSCODE_REFERENCE ({&quot;reference&quot;:&quot;LEGAL_FORM&quot;,&quot;scopeField&quot;:&quot;country&quot;}), or carrying its own code table (the observed codes and their target codes, the common target list, the rows per code: {&quot;codes&quot;:{&quot;Bronze&quot;:&quot;BRONZE&quot;},&quot;targets&quot;:[&quot;BRONZE&quot;],&quot;counts&quot;:{&quot;Bronze&quot;:70}}); unused for TRIM/COLLAPSE_SPACES/STRIP_ACCENTS/UPPER/LOWER/COUNTRY_TO_ISO2/CURRENCY_TO_ISO.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Argument</osd:label>
                                        <osd:description>Le sens dépend de kind : la liste de sentinelles pour EMPTY_TO_NULL (séparée par des barres verticales), les caractères à retirer pour STRIP_CHARS/NORMALISE_IDENTIFIER, un objet JSON nommant le référentiel et, pour un référentiel avec périmètre, le champ de périmètre pour TRANSCODE_REFERENCE ({&quot;reference&quot;:&quot;LEGAL_FORM&quot;,&quot;scopeField&quot;:&quot;country&quot;}), ou portant sa propre table de codes (les codes observés et leurs codes cibles, la liste cible commune, les lignes par code : {&quot;codes&quot;:{&quot;Bronze&quot;:&quot;BRONZE&quot;},&quot;targets&quot;:[&quot;BRONZE&quot;],&quot;counts&quot;:{&quot;Bronze&quot;:70}}) ; inutilisé pour TRIM/COLLAPSE_SPACES/STRIP_ACCENTS/UPPER/LOWER/COUNTRY_TO_ISO2/CURRENCY_TO_ISO.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="origin" minOccurs="1" maxOccurs="1" default="USER">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Origin</osd:label>
                                        <osd:description>Who proposed this cleaning step: a deterministic rule, the language model, or a person.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Origine</osd:label>
                                        <osd:description>Qui a proposé l'étape de nettoyage : une règle déterministe, le modèle de langage ou une personne.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="RULE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Rule</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Règle</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="LLM">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Language model</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Modèle de langage</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="USER">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">User</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Utilisateur</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="confidence" type="xs:int" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Confidence (%)</osd:label>
                                        <osd:description>0 to 100. Empty for a line entered by a person.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Confiance (%)</osd:label>
                                        <osd:description>De 0 à 100. Vide pour une ligne saisie par une personne.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="rationale" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Rationale</osd:label>
                                        <osd:description>Why it was proposed: the rule that fired, or the explanation given by the model.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Justification</osd:label>
                                        <osd:description>Pourquoi la proposition a été faite : la règle déclenchée, ou l'explication donnée par le modèle.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="status" minOccurs="1" maxOccurs="1" default="PROPOSED">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Status</osd:label>
                                        <osd:description>Nothing is generated from a line that is not accepted.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Statut</osd:label>
                                        <osd:description>Rien n'est généré depuis une ligne qui n'est pas acceptée.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="PROPOSED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Proposed</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Proposé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="ACCEPTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Accepted</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Accepté</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="REJECTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Rejected</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Refusé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="APPLIED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Applied</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Appliqué</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="valuesSeen" type="xs:decimal" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Values seen</osd:label>
                                        <osd:description>Rows read when this step was last checked against the landing data.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Valeurs vues</osd:label>
                                        <osd:description>Lignes lues au dernier contrôle de cette étape sur les données du landing.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="valuesChanged" type="xs:decimal" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Values changed</osd:label>
                                        <osd:description>Of those, how many this step would actually change.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Valeurs modifiées</osd:label>
                                        <osd:description>Parmi elles, combien cette étape modifierait réellement.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="valuesUnresolved" type="xs:decimal" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Values unresolved</osd:label>
                                        <osd:description>For a lookup-based kind (COUNTRY_TO_ISO2, CURRENCY_TO_ISO, TRANSCODE_REFERENCE): values left unchanged because nothing matched - never invented.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Valeurs non résolues</osd:label>
                                        <osd:description>Pour une nature fondée sur un référentiel (COUNTRY_TO_ISO2, CURRENCY_TO_ISO, TRANSCODE_REFERENCE) : valeurs laissées telles quelles faute de correspondance - jamais inventées.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="examples" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Examples</osd:label>
                                        <osd:description>At most 5 &quot;before -&gt; after&quot; pairs. Never a real value for a column the catalog tags as personal data: a shape is stored instead.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Exemples</osd:label>
                                        <osd:description>Au plus 5 paires « avant -&gt; après ». Jamais une valeur réelle pour une colonne étiquetée donnée personnelle par le catalogue : une forme est stockée à la place.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="checkedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Checked</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Vérifiée le</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="QualityRule" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Quality rules</osd:label>
                            <osd:description>A validation rule proposed for the staging model, with where it would be enforced.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Règles de qualité</osd:label>
                            <osd:description>Une règle de validation proposée pour le modèle de staging, avec où elle serait appliquée.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/id </primaryKeys>
                                <defaultLabel>${./kind} ${./argument}</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" type="id" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="entity" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Entity</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Entité</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/StagingEntity</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="attribute" type="xs:string" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Attribute</osd:label>
                                        <osd:description>Empty for an entity-level rule (a cross-column check); set for a rule scoped to one attribute.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Attribut</osd:label>
                                        <osd:description>Vide pour une règle au niveau de l'entité (contrôle croisant plusieurs colonnes) ; renseigné pour une règle portant sur un seul attribut.</osd:description>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/StagingAttribute</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="kind" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Kind</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Nature</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="MANDATORY">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Mandatory</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Obligatoire</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="PATTERN">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Pattern</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Motif</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="REFERENCE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Reference list</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Liste de référence</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="CHECK_DIGIT">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Check digit</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Clé de contrôle</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="UNIQUE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Unique</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Unique</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="argument" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Argument</osd:label>
                                        <osd:description>The pattern (PATTERN), the reference kind (REFERENCE: COUNTRY/CURRENCY/LEGAL_FORM), or the identifier type (CHECK_DIGIT: IBAN/LEI/SIREN/SIRET).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Argument</osd:label>
                                        <osd:description>Le motif (PATTERN), la nature du référentiel (REFERENCE : COUNTRY/CURRENCY/LEGAL_FORM), ou le type d'identifiant (CHECK_DIGIT : IBAN/LEI/SIREN/SIRET).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="severity" minOccurs="1" maxOccurs="1" default="WARN">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Severity</osd:label>
                                        <osd:description>MODEL_CONSTRAINT: becomes a facet or foreign key of the staging model. REJECT: the transfer rejects the row. WARN: the row passes, the problem is recorded. A failing check digit always starts WARN, never REJECT, until a person raises it.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Gravité</osd:label>
                                        <osd:description>MODEL_CONSTRAINT : devient une facette ou une clé étrangère du modèle de staging. REJECT : le transfert rejette la ligne. WARN : la ligne passe, le problème est enregistré. Une clé de contrôle en échec démarre toujours en WARN, jamais REJECT, tant qu'une personne ne l'a pas relevé.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="MODEL_CONSTRAINT">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Model constraint (facet/foreign key)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Contrainte du modèle (facette/clé étrangère)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="REJECT">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Reject the row</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Rejeter la ligne</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="WARN">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Warn, keep the row</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Avertir, garder la ligne</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="origin" minOccurs="1" maxOccurs="1" default="USER">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Origin</osd:label>
                                        <osd:description>Who proposed this quality rule: a deterministic rule, the language model, or a person.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Origine</osd:label>
                                        <osd:description>Qui a proposé la règle de qualité : une règle déterministe, le modèle de langage ou une personne.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="RULE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Rule</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Règle</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="LLM">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Language model</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Modèle de langage</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="USER">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">User</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Utilisateur</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="confidence" type="xs:int" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Confidence (%)</osd:label>
                                        <osd:description>0 to 100. Empty for a line entered by a person.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Confiance (%)</osd:label>
                                        <osd:description>De 0 à 100. Vide pour une ligne saisie par une personne.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="rationale" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Rationale</osd:label>
                                        <osd:description>Why it was proposed: the rule that fired, or the explanation given by the model.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Justification</osd:label>
                                        <osd:description>Pourquoi la proposition a été faite : la règle déclenchée, ou l'explication donnée par le modèle.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="status" minOccurs="1" maxOccurs="1" default="PROPOSED">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Status</osd:label>
                                        <osd:description>Nothing is generated from a line that is not accepted.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Statut</osd:label>
                                        <osd:description>Rien n'est généré depuis une ligne qui n'est pas acceptée.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="PROPOSED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Proposed</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Proposé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="ACCEPTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Accepted</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Accepté</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="REJECTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Rejected</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Refusé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="APPLIED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Applied</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Appliqué</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="valuesSeen" type="xs:decimal" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Values seen</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Valeurs vues</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="valuesFailing" type="xs:decimal" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Values failing</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Valeurs en échec</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="examples" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Examples</osd:label>
                                        <osd:description>At most 5 failing values. Never a real value for a column the catalog tags as personal data: a shape is stored instead.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Exemples</osd:label>
                                        <osd:description>Au plus 5 valeurs en échec. Jamais une valeur réelle pour une colonne étiquetée donnée personnelle par le catalogue : une forme est stockée à la place.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="checkedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Checked</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Vérifiée le</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="failureBreakdown" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Failure breakdown (JSON)</osd:label>
                                        <osd:description>JSON {&quot;attribute&quot;: name, &quot;groups&quot;: [{&quot;value&quot;, &quot;seen&quot;, &quot;failing&quot;, &quot;examples&quot;: [...]}]}: the failing values of this rule grouped by ONE other attribute of the same entity (the one that best separates failing from passing values), measured on the landing tables with the same bounds as valuesSeen/valuesFailing. At most 5 example values per group; never a real value for a column the catalog tags as personal data. Empty when never measured.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Répartition des échecs (JSON)</osd:label>
                                        <osd:description>JSON {&quot;attribute&quot;: nom, &quot;groups&quot;: [{&quot;value&quot;, &quot;seen&quot;, &quot;failing&quot;, &quot;examples&quot;: [...]}]} : les valeurs en échec de cette règle regroupées par UN autre attribut de la même entité (celui qui sépare le mieux les valeurs en échec de celles qui passent), mesuré sur les tables du landing avec les mêmes bornes que valuesSeen/valuesFailing. Au plus 5 valeurs d'exemple par groupe ; jamais une valeur réelle pour une colonne étiquetée donnée personnelle par le catalogue. Vide si jamais mesuré.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="4000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="conditionAttribute" type="xs:string" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Condition attribute</osd:label>
                                        <osd:description>With conditionValues: the rule applies only to rows whose staging value of this attribute (an attribute of the same entity) is one of conditionValues. Empty = the rule always applies. Never set on a MODEL_CONSTRAINT rule (a model facet cannot be conditional).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Attribut de condition</osd:label>
                                        <osd:description>Avec conditionValues : la règle ne s'applique qu'aux lignes dont la valeur de staging de cet attribut (de la même entité) est l'une des conditionValues. Vide = la règle s'applique toujours. Jamais posé sur une règle MODEL_CONSTRAINT (une facette de modèle ne peut pas être conditionnelle).</osd:description>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/StagingAttribute</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="conditionValues" minOccurs="0" maxOccurs="unbounded">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Condition values</osd:label>
                                        <osd:description>The values of conditionAttribute (compared on the produced staging value, trimmed, case-insensitive) under which the rule applies. Empty = always.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Valeurs de condition</osd:label>
                                        <osd:description>Les valeurs de conditionAttribute (comparées à la valeur de staging produite, sans espaces autour, insensible à la casse) sous lesquelles la règle s'applique. Vide = toujours.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="lastLoadChecked" type="xs:decimal" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Rows checked at last load</osd:label>
                                        <osd:description>Non-blank values this rule actually evaluated at the last transfer (REJECT/WARN kinds only - a MODEL_CONSTRAINT rule is never executed at transfer, see staging/generate).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Lignes contrôlées au dernier chargement</osd:label>
                                        <osd:description>Valeurs non vides réellement évaluées par cette règle au dernier transfert (natures REJECT/WARN seulement - une règle MODEL_CONSTRAINT n'est jamais exécutée au transfert, voir staging/generate).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="lastLoadFailing" type="xs:decimal" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Rows failing at last load</osd:label>
                                        <osd:description>Of those, how many failed this rule - rejected (REJECT) or kept with a warning (WARN).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Lignes en échec au dernier chargement</osd:label>
                                        <osd:description>Parmi elles, combien ont échoué à cette règle - rejetées (REJECT) ou conservées avec un avertissement (WARN).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="lastLoadExamples" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Failing rows at last load</osd:label>
                                        <osd:description>At most 10 sourceSystem|sourceId of a failing row (a real business KEY, never a name or the failing value itself) - how a person finds them.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Lignes en échec au dernier chargement</osd:label>
                                        <osd:description>Au plus 10 sourceSystem|sourceId d'une ligne en échec (une clé métier réelle, jamais un nom ni la valeur en échec elle-même) - de quoi les retrouver.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="lastLoadCheckedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Last checked at load</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dernier contrôle au chargement</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="ReferenceBinding" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Reference bindings</osd:label>
                            <osd:description>Where a closed reference list lives on this instance, read by the quality detectors instead of embedding a copy.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Rattachements de référentiels</osd:label>
                            <osd:description>Où vit un référentiel fermé sur cette instance, lu par les détecteurs de qualité plutôt que d'en garder une copie.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/kind </primaryKeys>
                                <defaultLabel>${./kind}</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="kind" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Kind</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Nature</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="COUNTRY">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Country</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Pays</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="CURRENCY">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Currency</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Devise</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="LEGAL_FORM">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Legal form</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Forme juridique</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="dataspace" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Dataspace</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dataspace</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="dataset" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Dataset</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dataset</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="tablePath" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Table</osd:label>
                                        <osd:description>e.g. /root/Country.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Table</osd:label>
                                        <osd:description>ex. /root/Country.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="codeField" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Code field</osd:label>
                                        <osd:description>Field of the reference table whose value becomes the normalised code (e.g. Alpha2Code, AlphaCode, Code).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Champ code</osd:label>
                                        <osd:description>Champ de la table de référence dont la valeur devient le code normalisé (ex. Alpha2Code, AlphaCode, Code).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="labelFields" minOccurs="1" maxOccurs="unbounded">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Label fields</osd:label>
                                        <osd:description>Fields of the reference table a landing value is matched against (case-folded, accents and punctuation stripped), e.g. Name, NameFR, Alpha3Code.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Champs libellé</osd:label>
                                        <osd:description>Champs de la table de référence auxquels une valeur du landing est comparée (casse, accents et ponctuation neutralisés), ex. Name, NameFR, Alpha3Code.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="scopeField" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Scope field</osd:label>
                                        <osd:description>Empty for COUNTRY/CURRENCY. For a binding matched within a second column (LEGAL_FORM: Country), the reference table's own field carrying that scope - the matching landing column is named by the MappingStep's own argument, not here.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Champ de périmètre</osd:label>
                                        <osd:description>Vide pour COUNTRY/CURRENCY. Pour un rattachement apparié par une seconde colonne (LEGAL_FORM : Country), le champ de la table de référence qui porte ce périmètre - la colonne du landing correspondante est nommée par l'argument du MappingStep, pas ici.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="synonyms" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Synonyms</osd:label>
                                        <osd:description>Optional JSON object of alias -&gt; code, for values the reference table itself does not resolve exactly (e.g. {&quot;UK&quot;:&quot;GB&quot;,&quot;USA&quot;:&quot;US&quot;}). Reviewed once, then a plain lookup - never re-derived live.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Synonymes</osd:label>
                                        <osd:description>Objet JSON optionnel alias -&gt; code, pour les valeurs que la table de référence elle-même ne résout pas exactement (ex. {&quot;UK&quot;:&quot;GB&quot;,&quot;USA&quot;:&quot;US&quot;}). Revu une fois, puis une simple table de correspondance - jamais recalculé à la volée.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="4000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="CapabilitySuggestion" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Capability suggestions</osd:label>
                            <osd:description>A script constraint, script derivation or external service the language model suggests, from what already exists on the instance.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Suggestions de capacité</osd:label>
                            <osd:description>Une contrainte de script, une dérivation de script ou un service externe que le modèle de langage suggère, d'après ce qui existe déjà sur l'instance.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/id </primaryKeys>
                                <defaultLabel>${./nature}</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" type="id" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="project" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Project</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Projet</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/Project</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="entity" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Entity</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Entité</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/StagingEntity</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="attribute" type="xs:string" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Attribute</osd:label>
                                        <osd:description>Empty for an entity-level suggestion (a cross-column script constraint, or a service with no single-attribute focus); set for one scoped to one attribute. SCRIPT_DERIVATION: the NEW derived attribute this suggestion computes (created alongside it, derivedFrom/derivation=SCRIPT) - never the source attribute, which is named in binding instead.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Attribut</osd:label>
                                        <osd:description>Vide pour une suggestion au niveau de l'entité (contrainte de script croisant plusieurs colonnes, ou service sans attribut unique) ; renseigné pour une suggestion portant sur un seul attribut. SCRIPT_DERIVATION : le NOUVEL attribut dérivé que cette suggestion calcule (créé avec elle, derivedFrom/derivation=SCRIPT) - jamais l'attribut source, nommé dans binding à la place.</osd:description>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/StagingAttribute</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="nature" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Nature</osd:label>
                                        <osd:description>SCRIPT_CONSTRAINT: an existing published EBX Script library function the model suggests positioning on the model, run by the validation engine. EXTERNAL_SERVICE: an existing connector operation the model suggests a person look into (verification, enrichment...) - never called on real data by this pass. SCRIPT_DERIVATION: an existing published EBX Script library function whose return value becomes a NEW computed attribute (docs/SCRIPT-DERIVATION.md).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Nature</osd:label>
                                        <osd:description>SCRIPT_CONSTRAINT : une fonction d'une bibliothèque EBX Script déjà publiée que le modèle suggère de poser sur le modèle, exécutée par le moteur de validation. EXTERNAL_SERVICE : une opération de connecteur existante que le modèle suggère qu'une personne regarde (vérification, enrichissement...) - jamais appelée sur des données réelles par cette passe. SCRIPT_DERIVATION : une fonction d'une bibliothèque EBX Script déjà publiée dont la valeur de retour devient un NOUVEL attribut calculé (docs/SCRIPT-DERIVATION.md).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="SCRIPT_CONSTRAINT">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Script constraint</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Contrainte de script</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="EXTERNAL_SERVICE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">External service</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Service externe</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="SCRIPT_DERIVATION">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Script derivation</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Dérivation de script</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="zone" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Zone</osd:label>
                                        <osd:description>SCRIPT_CONSTRAINT: STAGING or MASTER, where the constraint would be positioned once attached. SCRIPT_DERIVATION: always STAGING. Empty for EXTERNAL_SERVICE.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Zone</osd:label>
                                        <osd:description>SCRIPT_CONSTRAINT : STAGING ou MDM, où la contrainte serait posée une fois attachée. SCRIPT_DERIVATION : toujours STAGING. Vide pour EXTERNAL_SERVICE.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="STAGING">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Staging</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Staging</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="MASTER">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">MDM</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">MDM</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="targetLibrary" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Library</osd:label>
                                        <osd:description>SCRIPT_CONSTRAINT/SCRIPT_DERIVATION only: idePath of the published library (ebx-scripting MCP server), e.g. library/Fasttrack/validator/IBAN.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Bibliothèque</osd:label>
                                        <osd:description>SCRIPT_CONSTRAINT/SCRIPT_DERIVATION seulement : idePath de la bibliothèque publiée (serveur MCP ebx-scripting), ex. library/Fasttrack/validator/IBAN.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="targetFunction" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Function</osd:label>
                                        <osd:description>SCRIPT_CONSTRAINT/SCRIPT_DERIVATION only: exported function name of the library above.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Fonction</osd:label>
                                        <osd:description>SCRIPT_CONSTRAINT/SCRIPT_DERIVATION seulement : nom de la fonction exportée de la bibliothèque ci-dessus.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="targetImportName" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Import name</osd:label>
                                        <osd:description>SCRIPT_CONSTRAINT/SCRIPT_DERIVATION only: the library's own import name (get_script &quot;name&quot;, e.g. Fasttrack.lib.iban - &quot;import Fasttrack.lib.iban as iban;&quot;), looked up from the inventory, never chosen by the model. Needed by a later, out-of-scope apply step.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Nom d'import</osd:label>
                                        <osd:description>SCRIPT_CONSTRAINT/SCRIPT_DERIVATION seulement : le nom d'import propre de la bibliothèque (« name » de get_script, ex. Fasttrack.lib.iban - « import Fasttrack.lib.iban as iban; »), retrouvé dans l'inventaire, jamais choisi par le modèle. Nécessaire à une étape d'application ultérieure, hors périmètre.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="connectorId" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Connector</osd:label>
                                        <osd:description>EXTERNAL_SERVICE only: id of the ebx-connectors connector.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Connecteur</osd:label>
                                        <osd:description>EXTERNAL_SERVICE seulement : identifiant du connecteur ebx-connectors.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="connectorOperation" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Operation</osd:label>
                                        <osd:description>EXTERNAL_SERVICE only: a read or search operation of the connector above.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Opération</osd:label>
                                        <osd:description>EXTERNAL_SERVICE seulement : une opération de lecture ou de recherche du connecteur ci-dessus.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="binding" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Binding (JSON)</osd:label>
                                        <osd:description>Which accepted attribute(s) (or, for a script parameter with no matching attribute, a documented literal constant) feed which function parameter / operation input. Outputs are never part of this binding - EXTERNAL_SERVICE never calls the service, so an output is unknown; which output could fill which attribute, if relevant, is free text in the rationale instead. Never executed by this suggestion pass - read by a later, out-of-scope apply step.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Rattachement (JSON)</osd:label>
                                        <osd:description>Quel(s) attribut(s) accepté(s) (ou, pour un paramètre de script sans attribut correspondant, une constante littérale documentée) alimentent quel paramètre de fonction / entrée d'opération. Les sorties ne font jamais partie de ce rattachement - EXTERNAL_SERVICE n'appelle jamais le service, une sortie est donc inconnue ; quelle sortie pourrait alimenter quel attribut, si pertinent, est du texte libre dans la justification. Jamais exécuté par cette passe de suggestion - lu par une étape d'application ultérieure, hors périmètre.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="4000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="userMessage" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Message shown on the record</osd:label>
                                        <osd:description>SCRIPT_CONSTRAINT only: the short, neutral sentence (no code identifiers) a business user reads on a record this constraint flags - written by the language model, sanitised to a single line and 160 characters server-side. Empty on a row suggested before this field existed; ebx.CapabilityApplier then builds a fallback from the attribute label and the function's own documentation.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Message affiché sur l'enregistrement</osd:label>
                                        <osd:description>SCRIPT_CONSTRAINT seulement : la phrase courte et neutre (sans identifiant de code) qu'une personne métier lit sur un enregistrement signalé par cette contrainte - rédigée par le modèle de langage, ramenée à une seule ligne et 160 caractères côté serveur. Vide sur une ligne proposée avant l'existence de ce champ ; ebx.CapabilityApplier construit alors une phrase de repli depuis le libellé de l'attribut et la documentation de la fonction.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="200"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="severity" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Severity</osd:label>
                                        <osd:description>SCRIPT_CONSTRAINT only: WARN or ERROR, always set by the pass for that nature - ERROR only where a wrong value must block, typically the master zone. Never decided by the model alone below WARN vs ERROR - a person raises it. Empty for EXTERNAL_SERVICE - no default value: a severity means nothing for advice that is never attached or run.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Gravité</osd:label>
                                        <osd:description>SCRIPT_CONSTRAINT seulement : WARN ou ERROR, toujours renseigné par la passe pour cette nature - ERROR seulement là où une valeur erronée doit bloquer, typiquement la zone MDM. Jamais décidé seul par le modèle au-delà de WARN vs ERROR - une personne l'élève. Vide pour EXTERNAL_SERVICE - pas de valeur par défaut : une gravité ne veut rien dire pour un conseil jamais attaché ni exécuté.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="WARN">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Warn, keep the record</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Avertir, garder l'enregistrement</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="ERROR">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Block the record</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Bloquer l'enregistrement</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="transferPolicy" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Transfer policy</osd:label>
                                        <osd:description>SCRIPT_CONSTRAINT + zone STAGING only: WARN keeps a firing record in master with a recorded warning; REJECT sends it to TransferReject instead, never reaching master. Blank (default): unenforced, the constraint stays a pure flag on the staging validation report, today's behaviour. Never REJECT from the language model alone - a person raises it, same rule as QualityRule.severity.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Politique au transfert</osd:label>
                                        <osd:description>SCRIPT_CONSTRAINT + zone STAGING seulement : WARN garde en MDM un enregistrement en échec avec un avertissement enregistré ; REJECT l'envoie vers TransferReject à la place, il n'atteint jamais le MDM. Vide (défaut) : non appliqué, la contrainte reste un simple signal sur le rapport de validation du staging, comportement actuel. Jamais REJECT depuis le modèle de langage seul - une personne l'élève, même règle que QualityRule.severity.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="WARN">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Warn, keep the record in master</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Avertir, garder l'enregistrement dans le MDM</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="REJECT">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Reject the row at transfer</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Rejeter la ligne au transfert</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="ready" type="xs:boolean" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Ready to use?</osd:label>
                                        <osd:description>EXTERNAL_SERVICE only: whether the connector has its secrets set and is active - a suggestion is never hidden for being not ready, only flagged.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Prêt à l'emploi ?</osd:label>
                                        <osd:description>EXTERNAL_SERVICE seulement : le connecteur a-t-il ses secrets renseignés et est-il actif - une suggestion n'est jamais cachée faute d'être prête, seulement signalée.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="readinessDetail" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Readiness detail</osd:label>
                                        <osd:description>Why a service is or is not ready, e.g. &quot;secrets not set&quot; or &quot;connector inactive&quot;.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Détail de disponibilité</osd:label>
                                        <osd:description>Pourquoi un service est prêt ou non, ex. « secrets non renseignés » ou « connecteur inactif ».</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="pricing" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Pricing</osd:label>
                                        <osd:description>EXTERNAL_SERVICE only: relayed from ebx-connectors (connectors_list), UNKNOWN when that Connectors build or that connector never reported one. A plain structural tag, never a Java judgment of cost - the model orders its suggestions from it (free/ready first), a person judges the actual trade-off.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Tarification</osd:label>
                                        <osd:description>EXTERNAL_SERVICE seulement : relayé depuis ebx-connectors (connectors_list), UNKNOWN quand ce build de Connectors ou ce connecteur n'en a jamais signalé. Une simple étiquette structurelle, jamais un jugement de coût fait en Java - le modèle en ordonne ses suggestions (gratuit/prêt d'abord), une personne juge le compromis réel.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="FREE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Free</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Gratuit</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="FREEMIUM">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Freemium</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Freemium</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="PAID">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Paid</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Payant</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="UNKNOWN">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Unknown</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Inconnu</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="pricingNote" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Pricing note</osd:label>
                                        <osd:description>Free text alongside pricing, e.g. &quot;first 1000 calls/month free&quot; - relayed as-is, empty when ebx-connectors gave none.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Note de tarification</osd:label>
                                        <osd:description>Texte libre accompagnant la tarification, ex. « 1000 premiers appels/mois gratuits » - relayé tel quel, vide si ebx-connectors n'en a donné aucune.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="alternativeTo" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Alternative to</osd:label>
                                        <osd:description>EXTERNAL_SERVICE only: set when this suggestion is offered as an alternative to a NOT_CONFIGURED or costlier one - names the preferred READY/free connector (id or plain text), never hidden, a person may still prefer this one once it is configured or paid for. Empty when this suggestion IS the preferred choice.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Alternative à</osd:label>
                                        <osd:description>EXTERNAL_SERVICE seulement : renseigné quand cette suggestion est proposée en alternative à une autre NOT_CONFIGURED ou plus coûteuse - nomme le connecteur préféré prêt/gratuit (identifiant ou texte libre), jamais caché, une personne peut préférer celui-ci une fois configuré ou payé. Vide quand cette suggestion EST le choix préféré.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="origin" minOccurs="1" maxOccurs="1" default="USER">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Origin</osd:label>
                                        <osd:description>Who proposed this capability suggestion: a deterministic rule, the language model, or a person.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Origine</osd:label>
                                        <osd:description>Qui a proposé la suggestion de capacité : une règle déterministe, le modèle de langage ou une personne.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="RULE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Rule</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Règle</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="LLM">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Language model</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Modèle de langage</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="USER">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">User</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Utilisateur</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="confidence" type="xs:int" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Confidence (%)</osd:label>
                                        <osd:description>0 to 100. Empty for a line entered by a person.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Confiance (%)</osd:label>
                                        <osd:description>De 0 à 100. Vide pour une ligne saisie par une personne.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="rationale" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Rationale</osd:label>
                                        <osd:description>Why it was proposed: the rule that fired, or the explanation given by the model.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Justification</osd:label>
                                        <osd:description>Pourquoi la proposition a été faite : la règle déclenchée, ou l'explication donnée par le modèle.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="status" minOccurs="1" maxOccurs="1" default="PROPOSED">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Status</osd:label>
                                        <osd:description>Nothing is generated from a line that is not accepted.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Statut</osd:label>
                                        <osd:description>Rien n'est généré depuis une ligne qui n'est pas acceptée.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="PROPOSED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Proposed</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Proposé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="ACCEPTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Accepted</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Accepté</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="REJECTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Rejected</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Refusé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="APPLIED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Applied</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Appliqué</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="SET_ASIDE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Set aside - kept for later</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Mis de côté - gardé pour plus tard</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="scriptName" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Script name</osd:label>
                                        <osd:description>SCRIPT_CONSTRAINT only: deterministic, derived from the target function and attribute(s) - stable across a re-apply, so the same target always replaces the same declared constraint in place (EBX: a script cannot be renamed, and re-declaring the same name replaces it). Blank for SCRIPT_DERIVATION - a functionField script has no name of its own.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Nom du script</osd:label>
                                        <osd:description>SCRIPT_CONSTRAINT seulement : déterministe, dérivé de la fonction cible et du ou des attributs - stable d'une réapplication à l'autre, si bien que la même cible remplace toujours la même contrainte déclarée en place (EBX : un script ne se renomme pas, et redéclarer le même nom le remplace). Vide pour SCRIPT_DERIVATION - un script functionField n'a pas de nom propre.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="64"/>
                                        <xs:pattern value="[A-Za-z][A-Za-z0-9_]*"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="constraintScope" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Constraint scope</osd:label>
                                        <osd:description>SCRIPT_CONSTRAINT only. NODE: the binding names exactly one accepted attribute, declared as a ConstraintOnNode on that field. TABLE: zero or several attributes, declared as a ConstraintOnTable (setDependencyToLocalNode would be dishonest otherwise - CLAUDE.md). Blank for SCRIPT_DERIVATION - no scope concept for a functionField.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Portée de la contrainte</osd:label>
                                        <osd:description>SCRIPT_CONSTRAINT seulement. NODE : le rattachement ne nomme qu'un seul attribut accepté, déclaré en ConstraintOnNode sur ce champ. TABLE : zéro ou plusieurs attributs, déclaré en ConstraintOnTable (setDependencyToLocalNode serait autrement malhonnête - CLAUDE.md). Vide pour SCRIPT_DERIVATION - pas de notion de portée pour un functionField.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="NODE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Node (one attribute)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Noeud (un attribut)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="TABLE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Table (whole record)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Table (tout l'enregistrement)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="appliedModel" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Applied to model</osd:label>
                                        <osd:description>data-model MCP name of the staging or master model the constraint/function was declared on, e.g. &lt;Project&gt;_Staging. SCRIPT_DERIVATION is always the STAGING model.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Modèle d'application</osd:label>
                                        <osd:description>Nom (serveur MCP data-model) du modèle de staging ou MDM sur lequel la contrainte/fonction a été déclarée, ex. &lt;Projet&gt;_Staging. SCRIPT_DERIVATION est toujours le modèle de staging.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="appliedElementPath" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Applied to element</osd:label>
                                        <osd:description>/root/&lt;Table&gt; (TABLE scope) or /root/&lt;Table&gt;/&lt;Field&gt; (NODE scope, or SCRIPT_DERIVATION - always one field) the constraint/function was declared on.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Élément d'application</osd:label>
                                        <osd:description>/root/&lt;Table&gt; (portée TABLE) ou /root/&lt;Table&gt;/&lt;Champ&gt; (portée NODE, ou SCRIPT_DERIVATION - toujours un champ) sur lequel la contrainte/fonction a été déclarée.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="appliedScriptIdePath" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Script idePath</osd:label>
                                        <osd:description>ebx-scripting idePath of the authored body, e.g. data-model/&lt;Model&gt;/root/&lt;Table&gt;/&lt;Field&gt;/@nodeConstraint/&lt;Name&gt; (SCRIPT_CONSTRAINT) or data-model/&lt;Model&gt;/root/&lt;Table&gt;/&lt;Field&gt;/@function (SCRIPT_DERIVATION - discovered via list_scripts, never assumed, see docs/SCRIPT-DERIVATION.md).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>idePath du script</osd:label>
                                        <osd:description>idePath (serveur MCP ebx-scripting) du corps rédigé, ex. data-model/&lt;Modèle&gt;/root/&lt;Table&gt;/&lt;Champ&gt;/@nodeConstraint/&lt;Nom&gt; (SCRIPT_CONSTRAINT) ou data-model/&lt;Modèle&gt;/root/&lt;Table&gt;/&lt;Champ&gt;/@function (SCRIPT_DERIVATION - découvert via list_scripts, jamais supposé, voir docs/SCRIPT-DERIVATION.md).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="scriptBody" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Script body</osd:label>
                                        <osd:description>The EBX Script source actually authored and published (deterministic template, or - SCRIPT_CONSTRAINT only - the language model's validated answer) - kept so a person can read exactly what runs without opening ebx-scripting. SCRIPT_DERIVATION bodies are always the deterministic template (capability.DerivationBodyBuilder) - no LLM authoring.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Corps du script</osd:label>
                                        <osd:description>Le source EBX Script réellement rédigé et publié (gabarit déterministe, ou - SCRIPT_CONSTRAINT seulement - réponse validée du modèle de langage) - conservé pour qu'une personne puisse lire exactement ce qui s'exécute sans ouvrir ebx-scripting. Les corps SCRIPT_DERIVATION sont toujours le gabarit déterministe (capability.DerivationBodyBuilder) - jamais rédigés par le modèle.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="20000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="explanation" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Explanation</osd:label>
                                        <osd:description>Plain-language description of what the applied constraint/function does, for a reviewer who will never read the script source (product owner, 2026-09-21).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Explication</osd:label>
                                        <osd:description>Description en langage clair de ce que fait la contrainte/fonction appliquée, pour un relecteur qui ne lira jamais le source du script (demande du commanditaire, 2026-09-21).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="recordsChecked" type="xs:decimal" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Records checked</osd:label>
                                        <osd:description>SCRIPT_CONSTRAINT only: rows of the target table read by the measured-effect pass, at measuredAt.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Enregistrements contrôlés</osd:label>
                                        <osd:description>SCRIPT_CONSTRAINT seulement : lignes de la table cible lues par la passe de mesure d'effet, à la date measuredAt.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="recordsReported" type="xs:decimal" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Records reported</osd:label>
                                        <osd:description>SCRIPT_CONSTRAINT only: of those, how many the validation engine reported against THIS constraint's own node/severity - see docs/CAPABILITY-APPLY.md for how the match is made and its limits.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Enregistrements signalés</osd:label>
                                        <osd:description>SCRIPT_CONSTRAINT seulement : parmi eux, combien le moteur de validation a signalés au titre du noeud/de la gravité propres à cette contrainte - voir docs/CAPABILITY-APPLY.md pour la méthode d'appariement et ses limites.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="offendingShapes" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Offending value shapes</osd:label>
                                        <osd:description>SCRIPT_CONSTRAINT only: up to 5 value SHAPES (quality.Shapes.of, never a real value) of records reported by this constraint.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Formes des valeurs en échec</osd:label>
                                        <osd:description>SCRIPT_CONSTRAINT seulement : jusqu'à 5 FORMES de valeur (quality.Shapes.of, jamais une valeur réelle) parmi les enregistrements signalés par cette contrainte.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="measuredAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Measured</osd:label>
                                        <osd:description>SCRIPT_CONSTRAINT only.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Mesuré le</osd:label>
                                        <osd:description>SCRIPT_CONSTRAINT seulement.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="appliedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Applied</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Appliqué le</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="applyMessage" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Apply message</osd:label>
                                        <osd:description>Set when the last apply/remove attempt failed - the row stays ACCEPTED, never left half-applied.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Message d'application</osd:label>
                                        <osd:description>Renseigné quand la dernière tentative d'application/retrait a échoué - la ligne reste ACCEPTED, jamais laissée à moitié appliquée.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="lastLoadChecked" type="xs:decimal" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Rows checked at last load</osd:label>
                                        <osd:description>Staging rows this constraint was evaluated against at the last staging -&gt; master transfer (transferPolicy WARN/REJECT only).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Lignes contrôlées au dernier chargement</osd:label>
                                        <osd:description>Lignes de staging évaluées par cette contrainte au dernier transfert staging -&gt; MDM (transferPolicy WARN/REJECT seulement).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="lastLoadFailing" type="xs:decimal" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Rows failing at last load</osd:label>
                                        <osd:description>Of those, how many failed - rejected (REJECT) or kept in master with a warning (WARN).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Lignes en échec au dernier chargement</osd:label>
                                        <osd:description>Parmi elles, combien ont échoué - rejetées (REJECT) ou conservées en MDM avec un avertissement (WARN).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="lastLoadExamples" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Failing rows at last load</osd:label>
                                        <osd:description>At most 10 sourceSystem|sourceId of a failing row - how a person finds them.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Lignes en échec au dernier chargement</osd:label>
                                        <osd:description>Au plus 10 sourceSystem|sourceId d'une ligne en échec - de quoi les retrouver.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="lastLoadCheckedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Last checked at load</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dernier contrôle au chargement</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="MatchPlan" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Matching plans</osd:label>
                            <osd:description>How the records of an entity are matched and merged in the master zone.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Plans de rapprochement</osd:label>
                            <osd:description>Comment les enregistrements d'une entité sont rapprochés et fusionnés dans la zone MDM.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/id </primaryKeys>
                                <defaultLabel>${./entity}</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" type="id" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="entity" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Entity</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Entité</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/StagingEntity</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="requirements" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Requirements</osd:label>
                                        <osd:description>What makes two records the same, in plain words; handed to the Match and Merge policy generator.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Exigences</osd:label>
                                        <osd:description>Ce qui fait que deux enregistrements sont le même, en clair ; transmis au générateur de politique de Match and Merge.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="100000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="matchingPolicy" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Matching policy</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Politique de rapprochement</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="mergePolicy" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Merge policy</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Politique de fusion</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="autoMerge" type="xs:boolean" minOccurs="0" maxOccurs="1" default="false">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Merge matches without review?</osd:label>
                                        <osd:description>false: every match is routed to the suspects, a data steward confirms each merge.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Fusionner sans revue ?</osd:label>
                                        <osd:description>false : chaque correspondance passe en suspect, un data steward confirme chaque fusion.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="evidence" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Evidence (JSON)</osd:label>
                                        <osd:description>One entry per field the plan mentions or considered: role, cross-system sharing, per-system fill, verdict - the structured sibling of the prose already folded into rationale.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Preuve (JSON)</osd:label>
                                        <osd:description>Une entrée par champ mentionné ou envisagé par le plan : rôle, partage entre systèmes, remplissage par système, verdict - la version structurée de la prose déjà repliée dans rationale.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="100000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="origin" minOccurs="1" maxOccurs="1" default="USER">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Origin</osd:label>
                                        <osd:description>Who proposed this matching plan: a deterministic rule, the language model, or a person.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Origine</osd:label>
                                        <osd:description>Qui a proposé le plan de rapprochement : une règle déterministe, le modèle de langage ou une personne.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="RULE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Rule</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Règle</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="LLM">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Language model</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Modèle de langage</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="USER">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">User</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Utilisateur</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="confidence" type="xs:int" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Confidence (%)</osd:label>
                                        <osd:description>0 to 100. Empty for a line entered by a person.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Confiance (%)</osd:label>
                                        <osd:description>De 0 à 100. Vide pour une ligne saisie par une personne.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="rationale" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Rationale</osd:label>
                                        <osd:description>Why it was proposed: the rule that fired, or the explanation given by the model.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Justification</osd:label>
                                        <osd:description>Pourquoi la proposition a été faite : la règle déclenchée, ou l'explication donnée par le modèle.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="status" minOccurs="1" maxOccurs="1" default="PROPOSED">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Status</osd:label>
                                        <osd:description>Nothing is generated from a line that is not accepted.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Statut</osd:label>
                                        <osd:description>Rien n'est généré depuis une ligne qui n'est pas acceptée.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="PROPOSED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Proposed</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Proposé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="ACCEPTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Accepted</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Accepté</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="REJECTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Rejected</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Refusé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="APPLIED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Applied</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Appliqué</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="SUPERSEDED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Superseded - new proposal requested</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Remplacé - nouvelle proposition demandée</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="message" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Message</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Message</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="reviewComment" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Review comment</osd:label>
                                        <osd:description>Why the plan was set aside (SUPERSEDED) or ruled out entirely (REJECTED) - passed to the language model when a new proposal is requested.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Commentaire de revue</osd:label>
                                        <osd:description>Pourquoi le plan a été mis de côté (SUPERSEDED) ou écarté définitivement (REJECTED) - transmis au modèle de langage lors d'une nouvelle proposition.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="previousRequirements" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Previous requirements</osd:label>
                                        <osd:description>The requirements JSON of the plan just superseded by a new proposal - kept so nothing is lost.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Exigences précédentes</osd:label>
                                        <osd:description>Le JSON d'exigences du plan tout juste remplacé par une nouvelle proposition - conservé pour ne rien perdre.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="100000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="PipelineStep" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Pipeline steps</osd:label>
                            <osd:description>What the factory did for a project, step by step; a failed step is resumed, not restarted from the top.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Étapes du pipeline</osd:label>
                            <osd:description>Ce que la factory a fait pour un projet, étape par étape ; une étape en échec se reprend, sans repartir du début.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/id </primaryKeys>
                                <defaultLabel>${./step} ${./scope}</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" type="id" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="project" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Project</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Projet</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/Project</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="step" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Step</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Étape</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="LANDING_RUN">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Landing: one-click run</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Landing : lancement en un clic</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="LANDING_MODEL">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Landing: data model</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Landing : modèle de données</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="LANDING_DATASET">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Landing: dataspace and dataset</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Landing : dataspace et dataset</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="LANDING_FLOWS">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Landing: flows</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Landing : flux</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="LANDING_LOAD">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Landing: load</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Landing : chargement</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="STAGING_SUGGEST">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Staging: suggestion</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Staging : suggestion</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="QUALITY_SUGGEST">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Staging: quality suggestion</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Staging : suggestion de qualité</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="QUALITY_SUGGEST_LLM">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Staging: quality suggestion (language model)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Staging : suggestion de qualité (modèle de langage)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="CAPABILITY_SUGGEST_LLM">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Capability suggestion (language model)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Suggestion de capacité (modèle de langage)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="CAPABILITY_APPLY">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Capability: apply</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Capacité : application</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="CAPABILITY_REMOVE">
                                            <xs:annotation>
