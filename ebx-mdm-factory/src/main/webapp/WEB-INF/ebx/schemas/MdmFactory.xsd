                            <xs:element name="masterKey" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Master record</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Enregistrement MDM</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="stagingTable" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Staging table</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Table de staging</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="stagingKey" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Staging record</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Enregistrement de staging</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="landingDataset" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Landing dataset</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dataset de landing</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="landingTable" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Landing table</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Table du landing</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="landingKey" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Landing record</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Enregistrement du landing</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="sourceSystem" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Source system</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Système source</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="sourceId" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Source id</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Identifiant source</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="loadId" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Load</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Chargement</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="occurredAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>At</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Le</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="goldenKey" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Current golden record</osd:label>
                                        <osd:description>The key of the golden record this source record currently belongs to, once matching has run. Empty until the matching lot fills it.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Golden record actuel</osd:label>
                                        <osd:description>La clé du golden record auquel appartient aujourd'hui cet enregistrement source, une fois le rapprochement exécuté. Vide tant que le lot de rapprochement ne l'a pas renseignée.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="TransferReject" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Transfer rejects</osd:label>
                            <osd:description>One landing row a transfer refused to write, with every reason - the landing row itself is only marked REJECTED, the detail lives here.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Rejets de transfert</osd:label>
                            <osd:description>Une ligne du landing qu'un transfert a refusé d'écrire, avec tous les motifs - la ligne du landing est seulement marquée REJECTED, le détail vit ici.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/project /entity /stage /sourceSystem /sourceId </primaryKeys>
                                <defaultLabel>${./sourceSystem}:${./sourceId}</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="project" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Project</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Projet</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/Project</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="entity" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Staging entity</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Entité du staging</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/StagingEntity</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="landingDataset" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Landing dataset</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dataset de landing</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="landingTable" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Landing table</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Table du landing</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="sourceSystem" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Source system</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Système source</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="sourceId" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Source id</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Identifiant source</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="loadId" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Load</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Chargement</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="stage" minOccurs="1" maxOccurs="1" default="STAGING">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Stage</osd:label>
                                        <osd:description>Which transfer rejected the row: landing to staging (this lot), or staging to master (a later lot).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Étape</osd:label>
                                        <osd:description>Quel transfert a rejeté la ligne : landing vers staging (ce lot), ou staging vers MDM (un lot ultérieur).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="STAGING">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Landing to staging</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Landing vers staging</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="MASTER">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Staging to master</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Staging vers MDM</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="reasons" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Reasons</osd:label>
                                        <osd:description>Every reason this row was rejected for, joined - a row can fail more than one check at once.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Motifs</osd:label>
                                        <osd:description>Tous les motifs de rejet de la ligne, mis bout à bout - une ligne peut échouer sur plusieurs contrôles à la fois.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="category" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Cause</osd:label>
                                        <osd:description>What set the row aside: a quality rule, a refusal by EBX (a value that does not fit its field), a check on the computed value, a mapping that could not compute it, or a rejected parent row. Empty on a row written before this field existed.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Cause</osd:label>
                                        <osd:description>Ce qui a mis la ligne de côté : une règle de qualité, un refus d'EBX (une valeur qui ne convient pas à son champ), un contrôle de la valeur calculée, une correspondance qui n'a pas pu la calculer, ou une ligne parente rejetée. Vide sur une ligne écrite avant ce champ.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="QUALITY_RULE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Quality rule</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Règle de qualité</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="EBX_REFUSAL">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Refused by EBX</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Refusé par EBX</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="DATA_CHECK">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Check on the computed value</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Contrôle de la valeur calculée</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="COMPUTATION">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Not computed</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Non calculé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="PARENT_REJECTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Parent rejected</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Parent rejeté</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="OTHER">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Other</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Autre</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="reasonCode" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Reason code</osd:label>
                                        <osd:description>What identical reasons have in common (the code, the field and the source column, never the value): the screen groups rows by it.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Code du motif</osd:label>
                                        <osd:description>Ce que des motifs identiques ont en commun (le code, le champ et la colonne source, jamais la valeur) : l'écran regroupe les lignes selon ce code.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="detail" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Technical detail</osd:label>
                                        <osd:description>The raw text EBX or the engine gave (a refused save's message), kept folded on the review screen.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Détail technique</osd:label>
                                        <osd:description>Le texte brut donné par EBX ou par le moteur (le message d'un enregistrement refusé), replié sur l'écran de revue.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="rejectedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Rejected</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Rejetée le</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="resolved" type="xs:boolean" minOccurs="0" maxOccurs="1" default="false">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Resolved?</osd:label>
                                        <osd:description>Set by a person once the source or the mapping has been fixed and the row is expected to load cleanly on the next transfer.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Résolue ?</osd:label>
                                        <osd:description>Positionné par une personne une fois la source ou le mapping corrigés, quand la ligne est censée se charger proprement au prochain transfert.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="acknowledged" type="xs:boolean" minOccurs="0" maxOccurs="1" default="false">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Acknowledged?</osd:label>
                                        <osd:description>Set by a data steward (screen &quot;Transfer rejects&quot;) once the reject has been looked at and set aside with a comment. An acknowledged reject that is still unresolved is kept until the retention deletes it; a later rejection of the same row opens it again.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Prise en compte ?</osd:label>
                                        <osd:description>Positionné par un data steward (écran « Rejets de transfert ») une fois le rejet examiné et écarté avec un commentaire. Un rejet pris en compte mais non résolu est conservé jusqu'à sa purge par la rétention ; un nouveau rejet de la même ligne le rouvre.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="reviewedBy" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Reviewed by</osd:label>
                                        <osd:description>The EBX user of the last review action (acknowledge or reopen).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Revu par</osd:label>
                                        <osd:description>L'utilisateur EBX de la dernière action de revue (prise en compte ou réouverture).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="reviewedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Reviewed</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Revu le</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="reviewComment" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Review comment</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Commentaire de revue</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="Favorite" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Favorites</osd:label>
                            <osd:description>Per-user shortcuts pinned with the star of the project explorer. Everybody sees only their own rows; nobody edits them by hand.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Favoris</osd:label>
                            <osd:description>Raccourcis de chaque utilisateur, épinglés avec l'étoile de l'explorateur de projets. Chacun ne voit que ses lignes ; personne ne les modifie à la main.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/userLogin /targetType /targetKey </primaryKeys>
                                <defaultLabel>${./userLogin} - ${./targetType} ${./targetKey}</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="userLogin" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>User</osd:label>
                                        <osd:description>EBX login of the owner of the shortcut.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Utilisateur</osd:label>
                                        <osd:description>Identifiant EBX du propriétaire du raccourci.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="targetType" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Kind</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Nature</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="PROJECT">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Project</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Projet</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="targetKey" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Target</osd:label>
                                        <osd:description>Primary key of the pinned record. No foreign key: one table serves every kind, and a deleted target only leaves a dangling shortcut.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Cible</osd:label>
                                        <osd:description>Clé primaire de la ligne épinglée. Sans clé étrangère : une seule table sert toutes les natures, et une cible supprimée ne laisse qu'un raccourci orphelin.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="createdAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Pinned at</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Épinglé le</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="DistributionTarget" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Distribution targets</osd:label>
                            <osd:description>One Connectors connection + write operation receiving the golden records of a project; see docs/DISTRIBUTION.md.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Cibles de diffusion</osd:label>
                            <osd:description>Une connexion Connectors et une opération d'écriture recevant les golden records d'un projet ; voir docs/DISTRIBUTION.md.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/id </primaryKeys>
                                <defaultLabel>${./connector}/${./operation} (${./mode})</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" type="id" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="project" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Project</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Projet</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/Project</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="connector" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Connector</osd:label>
                                        <osd:description>Id of the ebx-connectors connector receiving the records.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Connecteur</osd:label>
                                        <osd:description>Identifiant du connecteur ebx-connectors qui reçoit les enregistrements.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="operation" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Operation</osd:label>
                                        <osd:description>The write operation of the connector used to build the outbound mapping(s).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Opération</osd:label>
                                        <osd:description>L'opération d'écriture du connecteur utilisée pour construire le(s) mapping(s) sortant(s).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="connectorsMappingIds" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Connectors mapping ids</osd:label>
                                        <osd:description>One &quot;tablePath=mappingId&quot; pair per master table this target sends through, comma-separated (e.g. &quot;/root/Company=41,/root/Contact=42&quot;) - written by ebx.DistributionConfigurator, one OUTBOUND mapping per table. Never split by hand: read/write with distribution.TargetMappingList.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Ids des mappings Connectors</osd:label>
                                        <osd:description>Une paire « tablePath=mappingId » par table MDM par laquelle cette cible envoie, séparées par des virgules (ex. « /root/Company=41,/root/Contact=42 ») - écrit par ebx.DistributionConfigurator, un mapping OUTBOUND par table. Ne jamais découper à la main : lire/écrire avec distribution.TargetMappingList.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="1000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="tableDestinations" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Per-table destinations</osd:label>
                                        <osd:description>Round 6: one &quot;tablePath=destination&quot; pair per master table, comma-separated, same encoding as connectorsMappingIds - never split by hand, read/write with distribution.TargetMappingList. Only meaningful for a connector whose write operation needs a per-call destination rather than reading it from the mapping's own tablePath (Kafka: destination = the topic name, written as the outbound mapping input &quot;topic&quot;, with &quot;key&quot; = the table's own key field). Left blank/unused for a connector with no such need.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Destinations par table</osd:label>
                                        <osd:description>Round 6 : une paire « tablePath=destination » par table MDM, séparées par des virgules, même encodage que connectorsMappingIds - ne jamais découper à la main, lire/écrire avec distribution.TargetMappingList. Utile seulement pour un connecteur dont l'opération d'écriture a besoin d'une destination par appel plutôt que de la lire depuis le tablePath du mapping (Kafka : destination = le nom du topic, écrit comme entrée de mapping « topic », avec « key » = le champ clé de la table). Laissé vide/inutilisé pour un connecteur sans ce besoin.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="mode" minOccurs="1" maxOccurs="1" default="ON_DEMAND">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Mode</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Mode</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="REALTIME">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Real time</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Temps réel</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="ON_DEMAND">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">On demand</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">À la demande</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="SCHEDULED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Scheduled</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Planifié</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="cron" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Cron expression</osd:label>
                                        <osd:description>SCHEDULED only: the Scheduler REST API schedule expression.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Expression cron</osd:label>
                                        <osd:description>SCHEDULED uniquement : l'expression du planning de l'API REST Scheduler.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="scope" minOccurs="1" maxOccurs="1" default="CHANGED">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Scope</osd:label>
                                        <osd:description>ON_DEMAND/SCHEDULED only; ignored for REALTIME.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Portée</osd:label>
                                        <osd:description>ON_DEMAND/SCHEDULED uniquement ; ignoré pour REALTIME.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="CHANGED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Changed since last send</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Modifiés depuis le dernier envoi</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="ALL">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Every golden record</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Chaque golden record</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="approval" type="xs:boolean" minOccurs="0" maxOccurs="1" default="false">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Approval required?</osd:label>
                                        <osd:description>ON_DEMAND/SCHEDULED only: a user task &quot;Approve the send&quot; runs before the send (workflow MdmFactoryDistribution).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Approbation requise ?</osd:label>
                                        <osd:description>ON_DEMAND/SCHEDULED uniquement : une tâche utilisateur « Approuver l'envoi » s'exécute avant l'envoi (workflow MdmFactoryDistribution).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="watchedFields" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Watched fields</osd:label>
                                        <osd:description>REALTIME only. Empty: every field change of the record fires the trigger. Otherwise a comma-separated list of master field names - a modify event is only queued when one of them actually changed.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Champs surveillés</osd:label>
                                        <osd:description>REALTIME uniquement. Vide : tout changement de champ de l'enregistrement déclenche le déclencheur. Sinon une liste de noms de champs MDM séparés par des virgules - un événement de modification n'est mis en file que si l'un d'eux a réellement changé.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="includeCrosswalk" type="xs:boolean" minOccurs="0" maxOccurs="1" default="false">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Include cross-references?</osd:label>
                                        <osd:description>Connectors outbound input crosswalk=true.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Inclure les références croisées ?</osd:label>
                                        <osd:description>Entrée sortante Connectors crosswalk=true.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="includePending" type="xs:boolean" minOccurs="0" maxOccurs="1" default="false">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Include pending-suspect records?</osd:label>
                                        <osd:description>Default off: a record still awaiting a match decision is not sent.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Inclure les enregistrements suspects en attente ?</osd:label>
                                        <osd:description>Désactivé par défaut : un enregistrement encore en attente d'une décision de rapprochement n'est pas envoyé.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="state" minOccurs="1" maxOccurs="1" default="DRAFT">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>State</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>État</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="DRAFT">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Draft</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Brouillon</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="WAITING">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Waiting for the first full send</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">En attente du premier envoi complet</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="ARMED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Armed</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Armé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="PAUSED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Paused</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">En pause</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="DISABLED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Disabled</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Désactivé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="armedViaOverride" type="xs:boolean" minOccurs="0" maxOccurs="1" default="false">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Armed without a successful first full send?</osd:label>
                                        <osd:description>Set by the admin-only &quot;arm without it&quot; override (distribution.DistributionArmingGate). Kept for audit; never cleared automatically.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Armée sans premier envoi complet réussi ?</osd:label>
                                        <osd:description>Positionné par la dérogation « armer sans » réservée aux administrateurs (distribution.DistributionArmingGate). Conservé pour l'audit ; jamais effacé automatiquement.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="firstFullSendRunId" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>First full send run id</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Id de l'envoi complet initial</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="lastSendAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Last send</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dernier envoi</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="lastStatus" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Last status</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dernier statut</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="lastMessage" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Last message</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dernier message</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="scheduleKey" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Scheduler key</osd:label>
                                        <osd:description>SCHEDULED only: the Scheduler REST API schedule id.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Clé du planning</osd:label>
                                        <osd:description>SCHEDULED uniquement : l'id du planning de l'API REST Scheduler.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="launcherName" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Workflow launcher</osd:label>
                                        <osd:description>Row of /root/definition of dataspace Bworkflow_launchers created for this target.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Lanceur de workflow</osd:label>
                                        <osd:description>Ligne de /root/definition du dataspace Bworkflow_launchers créée pour cette cible.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="retireMode" minOccurs="1" maxOccurs="1" default="NOTICE">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Retire notice mode</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Mode des avis de retrait</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="NOTICE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Notice (retired document)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Avis (document marqué retiré)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="TOMBSTONE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Tombstone (Kafka only - not yet available)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Tombstone (Kafka uniquement - pas encore disponible)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="NONE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">None (no retire notice sent)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Aucun (pas d'avis de retrait envoyé)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="retireUndoneMerges" type="xs:boolean" minOccurs="0" maxOccurs="1" default="true">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Reinstate members of an undone merge?</osd:label>
                                        <osd:description>When a merge is undone, send a CREATE for every former member that is golden again (state back to GOLDEN). A member still awaiting a decision (PENDING_APPROVAL) is never reinstated by this alone.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Réintégrer les membres d'une fusion annulée ?</osd:label>
                                        <osd:description>Quand une fusion est annulée, envoyer une création pour chaque ancien membre redevenu golden (état de nouveau GOLDEN). Un membre encore en attente d'une décision (PENDING_APPROVAL) n'est jamais réintégré par ce seul mécanisme.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="mergeLogWatermark" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Merge log watermark</osd:label>
                                        <osd:description>JSON, one entry per master table path, e.g. {&quot;/root/Personne&quot;:{&quot;last&quot;:1,&quot;undone&quot;:[]}} - written by ebx.MergeLogWatcher only, after its outbox rows are committed (at-least-once: a crash between the two re-emits the same RETIREs, which coalesce/are harmless). Never edited by hand.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Repère du journal de fusion</osd:label>
                                        <osd:description>JSON, une entrée par table MDM, ex. {&quot;/root/Personne&quot;:{&quot;last&quot;:1,&quot;undone&quot;:[]}} - écrit uniquement par ebx.MergeLogWatcher, après validation de ses lignes de boîte d'envoi (au moins une fois : un plantage entre les deux réémet les mêmes retraits, sans conséquence). Jamais modifié à la main.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="4000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="DistributionEvent" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Distribution events</osd:label>
                            <osd:description>One outbox row for a REALTIME target, written by a master-table trigger, drained by the dispatcher; see docs/DISTRIBUTION.md.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Événements de diffusion</osd:label>
                            <osd:description>Une ligne de boîte d'envoi pour une cible REALTIME, écrite par un déclencheur de table MDM, vidée par le distributeur ; voir docs/DISTRIBUTION.md.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/id </primaryKeys>
                                <defaultLabel>${./tablePath} ${./recordKey} (${./change})</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" type="id" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="project" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Project</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Projet</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/Project</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="target" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Target</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Cible</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/DistributionTarget</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="tablePath" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Master table</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Table MDM</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="recordKey" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Record key</osd:label>
                                        <osd:description>Formatted primary key of the master record; never split by hand (CLAUDE.md sec 9).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Clé de l'enregistrement</osd:label>
                                        <osd:description>Clé primaire formatée de l'enregistrement MDM ; ne jamais découper à la main (CLAUDE.md sec 9).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="change" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Change</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Changement</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="CREATE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Create</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Création</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="MODIFY">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Modify</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Modification</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="DELETE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Delete</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Suppression</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="RETIRE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Retire (merged or unmerge-deleted)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Retrait (fusionné ou supprimé par annulation)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="status" minOccurs="1" maxOccurs="1" default="PENDING">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Status</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Statut</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="PENDING">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Pending</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">En attente</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="SENT">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Sent</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Envoyé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="FAILED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Failed</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">En échec</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="SKIPPED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Skipped (target paused or disabled)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Ignoré (cible en pause ou désactivée)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="attempts" type="xs:int" minOccurs="0" maxOccurs="1" default="0">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Attempts</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Tentatives</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="createdAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Created</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Créé le</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="sentAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Sent</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Envoyé le</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="message" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Message</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Message</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="survivorKey" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Survivor record</osd:label>
                                        <osd:description>change=RETIRE only: the golden record this one was merged into. Empty for an unmerge-deleted golden (no survivor) or for any other change.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Enregistrement survivant</osd:label>
                                        <osd:description>change=RETIRE uniquement : le golden record dans lequel celui-ci a été fusionné. Vide pour un golden supprimé par annulation de fusion (aucun survivant) ou pour tout autre changement.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="nextAttemptAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Next attempt</osd:label>
                                        <osd:description>Set on a failed attempt still under the retry budget; the dispatcher skips the row until this time.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Prochaine tentative</osd:label>
                                        <osd:description>Positionné après une tentative échouée encore dans le budget de nouvelles tentatives ; le distributeur ignore la ligne jusqu'à cette date.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="reason" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Reason</osd:label>
                                        <osd:description>Set only by the merge-log watch: MERGE (this record lost a match/merge) or UNMERGE (a merge was undone - the golden retires, or a member is reinstated). Empty for every event a table trigger wrote directly.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Motif</osd:label>
                                        <osd:description>Positionné uniquement par la veille du journal de fusion : MERGE (cet enregistrement a perdu un rapprochement/une fusion) ou UNMERGE (une fusion a été annulée - le golden est retiré, ou un membre est réintégré). Vide pour tout événement écrit directement par un déclencheur de table.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="MERGE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Merge</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Fusion</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="UNMERGE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Unmerge</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Annulation de fusion</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="mergeId" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Merge id</osd:label>
                                        <osd:description>Set only by the merge-log watch: the add-on's MergingProcess.id this event came from.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Id de fusion</osd:label>
                                        <osd:description>Positionné uniquement par la veille du journal de fusion : le MergingProcess.id de l'add-on à l'origine de cet événement.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="LoadPause" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Load pauses</osd:label>
                            <osd:description>A pause the factory applied during a load and has not lifted yet; see ebx.LoadPauseLedger. A row that survives a restart is an orphan the module lifts at start.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Pauses de chargement</osd:label>
                            <osd:description>Une pause que la factory a appliquée pendant un chargement et n'a pas encore levée ; voir ebx.LoadPauseLedger. Une ligne qui survit à un redémarrage est une orpheline que le module lève au démarrage.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/id </primaryKeys>
                                <defaultLabel>${./kind} ${./target} (${./ownerStep})</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" type="id" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="project" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Project key</osd:label>
                                        <osd:description>Primary key of the Project the pause belongs to. Plain text, not a foreign key.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Clé du projet</osd:label>
                                        <osd:description>Clé primaire du projet concerné par la pause. Texte simple, pas une clé étrangère.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="kind" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>What was paused</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Ce qui est en pause</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="DISTRIBUTION_TARGET">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Distribution target</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Cible de diffusion</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="MATCHING_TABLE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Matching of a master table</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Rapprochement d'une table MDM</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="target" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Target</osd:label>
                                        <osd:description>DISTRIBUTION_TARGET: the primary key of the DistributionTarget row. MATCHING_TABLE: the master table path, e.g. /root/Company.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Cible</osd:label>
                                        <osd:description>DISTRIBUTION_TARGET : la clé primaire de la ligne DistributionTarget. MATCHING_TABLE : le chemin de la table MDM, par exemple /root/Company.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="255"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="ownerStep" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Paused by step</osd:label>
                                        <osd:description>The pipeline step whose load applied the pause (STAGING_LOAD, MASTER_LOAD or MATCHING_RUN).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Mise en pause par l'étape</osd:label>
                                        <osd:description>L'étape du pipeline dont le chargement a mis en pause (STAGING_LOAD, MASTER_LOAD ou MATCHING_RUN).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="60"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="ownerToken" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Owner token</osd:label>
                                        <osd:description>Random token of the load that applied the pause. A token no live load of this server holds belongs to a load that is gone: the pause is an orphan.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Jeton du propriétaire</osd:label>
                                        <osd:description>Jeton aléatoire du chargement qui a mis en pause. Un jeton qu'aucun chargement vivant de ce serveur ne détient appartient à un chargement disparu : la pause est orpheline.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="60"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="pausedBy" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Launched by</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Lancé par</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="pausedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Paused at</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Mise en pause le</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="FactoryJob" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Background jobs</osd:label>
                            <osd:description>The durable queue of the factory's background jobs; see ebx.FactoryJobs.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Tâches de fond</osd:label>
                            <osd:description>La file durable des tâches de fond de la factory ; voir ebx.FactoryJobs.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/id </primaryKeys>
                                <defaultLabel>${./kind} (${./status})</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" type="id" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="project" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Project</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Projet</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/Project</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="resource" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Resource</osd:label>
                                        <osd:description>What the job writes: one job per resource of a project runs at a time, different resources run side by side.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Ressource</osd:label>
                                        <osd:description>Ce que la tâche écrit : une seule tâche par ressource d'un projet à la fois, des ressources différentes avancent en parallèle.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="SOURCES">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Sources</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Sources</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="LANDING">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Landing</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Landing</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="DESIGN">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Design (proposals)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Conception (propositions)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="STAGING">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Staging</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Staging</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="MASTER">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Master</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">MDM</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="MATCHING">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Matching</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Rapprochement</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="kind" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Kind</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Nature</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="60"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="params" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Parameters (JSON)</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Paramètres (JSON)</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="4000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="status" minOccurs="1" maxOccurs="1" default="QUEUED">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Status</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Statut</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="QUEUED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Queued</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">En file</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="RUNNING">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Running</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">En cours</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="DONE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Done</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Terminée</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="FAILED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Failed</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">En échec</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="CANCELLED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Cancelled</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Annulée</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="INTERRUPTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Interrupted (server restart)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Interrompue (redémarrage du serveur)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="DONE_WITH_FAILURES">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Done with failures</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Terminée avec des échecs</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="requestedBy" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Requested by</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Demandée par</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="via" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Via</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Via</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="200"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="requestedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Requested</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Demandée le</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="startedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Started</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Démarrée le</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="endedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Ended</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Terminée le</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="stepId" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Pipeline step</osd:label>
                                        <osd:description>The PipelineStep the job reports its progress into.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Étape du pipeline</osd:label>
                                        <osd:description>L'étape du pipeline où la tâche consigne sa progression.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="message" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Message</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Message</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="detail" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Failed items (JSON)</osd:label>
                                        <osd:description>For a job that ended DONE_WITH_FAILURES: the items that failed, as a JSON array of {id, label, reason} (the landing tables not loaded, the matching objects refused).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Éléments en échec (JSON)</osd:label>
                                        <osd:description>Pour une tâche terminée avec des échecs : les éléments en échec, en tableau JSON de {id, label, reason} (les tables de landing non chargées, les objets de rapprochement refusés).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="4000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="IntakeChain" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Intake chains</osd:label>
                            <osd:description>One chain (an instance of the workflow MdmFactoryPipeline in incremental mode) the automatic intake launched; see docs/AUTOMATIC-INTAKE.md.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Chaînes de prise en charge</osd:label>
                            <osd:description>Une chaîne (une instance du workflow MdmFactoryPipeline en mode incrémental) lancée par la prise en charge automatique ; voir docs/AUTOMATIC-INTAKE.md.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/id </primaryKeys>
                                <defaultLabel>${./startedAt} (${./status})</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Id</osd:label>
                                        <osd:description>A random UUID generated by the engine; also the token of the workflow data context (intakeChain).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Id</osd:label>
                                        <osd:description>Un UUID aléatoire généré par le moteur ; aussi le jeton du contexte de données du workflow (intakeChain).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="project" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Project</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Projet</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/Project</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="startedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Started</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Démarrée le</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="startedBy" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Launched for</osd:label>
                                        <osd:description>The EBX user the chain runs for: the person who switched the automatic intake on (the engine itself runs as the system user).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Lancée pour</osd:label>
                                        <osd:description>L'utilisateur EBX pour qui la chaîne tourne : la personne qui a activé la prise en charge automatique (le moteur tourne lui-même en utilisateur système).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="endedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Ended</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Terminée le</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="reason" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Reason</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Motif</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="QUIET">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Quiet period elapsed</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Période calme écoulée</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="MAX_WAIT">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Longest wait reached</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Attente maximale atteinte</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="BATCH_COMPLETE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Batch complete</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Lot terminé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="MANUAL">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Process now</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Traiter maintenant</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="SWEEP">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Safety sweep</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Balayage de sécurité</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="sources" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Applications</osd:label>
                                        <osd:description>Source systems that had rows waiting, comma-separated.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Applications</osd:label>
                                        <osd:description>Systèmes source qui avaient des lignes en attente, séparés par des virgules.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="400"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="rowsWaiting" type="xs:decimal" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Rows waiting</osd:label>
                                        <osd:description>New landing rows counted at launch.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Lignes en attente</osd:label>
                                        <osd:description>Lignes du landing nouvelles comptées au lancement.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="written" type="xs:decimal" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Written to staging</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Écrites en staging</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="unchanged" type="xs:decimal" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Unchanged</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Inchangées</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="rejected" type="xs:decimal" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Held back</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Retenues</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="status" minOccurs="1" maxOccurs="1" default="RUNNING">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Status</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Statut</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="RUNNING">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Running</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">En cours</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="DONE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Done</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Terminée</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="DONE_WITH_REJECTS">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Done, some rows held back</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Terminée, des lignes retenues</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="STOPPED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Stopped (too many rows held back)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Arrêtée (trop de lignes retenues)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="FAILED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Failed</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">En échec</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="message" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Message</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Message</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="workflowKey" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Workflow instance</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Instance de workflow</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="200"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="AccessRight" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Access rights</osd:label>
                            <osd:description>Who may use the MDM Factory: one row gives a role of the directory one right on the screens, the REST routes and the background jobs of the module. Nobody but the EBX administrator has a right until a row (or one of the default roles FactoryViewer, FactorySteward, FactoryDesigner) gives it. Only an administrator edits this table; a change applies within a few seconds.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Droits d'accès</osd:label>
                            <osd:description>Qui peut utiliser la MDM Factory : une ligne donne à un rôle de l'annuaire un droit sur les écrans, les routes REST et les tâches de fond du module. Personne d'autre que l'administrateur EBX n'a de droit tant qu'une ligne (ou l'un des rôles par défaut FactoryViewer, FactorySteward, FactoryDesigner) ne le donne pas. Seul un administrateur modifie cette table ; un changement s'applique en quelques secondes.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/profile </primaryKeys>
                                <defaultLabel>${./profile} - ${./right}</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="profile" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Role</osd:label>
                                        <osd:description>A role of the EBX directory. Its members receive the right of this row. &quot;Everyone&quot; gives the right to every authenticated user.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Rôle</osd:label>
                                        <osd:description>Un rôle de l'annuaire EBX. Ses membres reçoivent le droit de cette ligne. « Tout le monde » donne le droit à tout utilisateur authentifié.</osd:description>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:constraintEnumeration class="com.on.ebx.factory.ebx.FactoryRoleEnumeration"/>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="200"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="right" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Right</osd:label>
                                        <osd:description>Each right includes the previous ones. Viewer: the project explorer, the cockpit, the wizard and the proposal review read only, record lineage. Data steward: also the decisions on suspect pairs and on proposals. Designer: also every wizard action, the mapping matrix, the feed designer, generations, loads, matching runs and distribution set-up. Settings, the connection, deletion and resets stay with the EBX administrator.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Droit</osd:label>
                                        <osd:description>Chaque droit inclut les précédents. Lecteur : l'explorateur de projets, le cockpit, l'assistant et la revue des propositions en lecture, le lineage d'enregistrement. Data steward : en plus, les décisions sur les paires suspectes et sur les propositions. Concepteur : en plus, toutes les actions de l'assistant, la matrice de mapping, le designer de flux, les générations, les chargements, les rapprochements et la diffusion. Les réglages, la connexion, la suppression et les remises à zéro restent à l'administrateur EBX.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="VIEW">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Viewer (read)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Lecteur (lire)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="STEWARD">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Data steward (read and decide)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Data steward (lire et décider)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="DESIGN">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Designer (read, decide, design and run)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Concepteur (lire, décider, concevoir et exécuter)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="comment" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Comment</osd:label>
                                        <osd:description>Why this role has this right.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Commentaire</osd:label>
                                        <osd:description>Pourquoi ce rôle a ce droit.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="500"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="ProjectPack" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Project packs</osd:label>
                            <osd:description>A pack of the accelerator catalogue chosen for a CENTRALISATION project, with the specification it is adapted to.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Packs du projet</osd:label>
                            <osd:description>Un pack du catalogue d'accélérateurs choisi pour un projet en CENTRALISATION, avec la spécification à laquelle il est adapté.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/id </primaryKeys>
                                <defaultLabel>${./packKey}</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" type="id" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="project" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Project</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Projet</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/Project</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="packKey" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Pack</osd:label>
                                        <osd:description>Key of the pack in the accelerator catalogue.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Pack</osd:label>
                                        <osd:description>Clé du pack dans le catalogue d'accélérateurs.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="packVersion" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Pack version</osd:label>
                                        <osd:description>Version of the pack when it was chosen: a later version is proposed as differences, never applied.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Version du pack</osd:label>
                                        <osd:description>Version du pack au moment du choix : une version ultérieure est proposée sous forme de différences, jamais appliquée.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="options" minOccurs="0" maxOccurs="unbounded">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Options</osd:label>
                                        <osd:description>Options of the pack taken for this project.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Options</osd:label>
                                        <osd:description>Options du pack retenues pour ce projet.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="specification" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Specification</osd:label>
                                        <osd:description>The need of the project in the words of the person (or the specification text); it is sent to the language model, fenced as data.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Spécification</osd:label>
                                        <osd:description>Le besoin du projet dans les mots de la personne (ou le texte de la spécification) ; il est envoyé au modèle de langage, encadré comme donnée.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="20000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="specificationKind" minOccurs="0" maxOccurs="1" default="TEXT">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Specification kind</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Nature de la spécification</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="TEXT">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Free text</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Texte libre</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="FILE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Workbook or file</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Classeur ou fichier</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="MODEL">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Existing model to take over</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Modèle existant à reprendre</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="chosenBy" minOccurs="1" maxOccurs="1" default="USER">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Chosen by</osd:label>
                                        <osd:description>LLM: suggested by the model and kept; USER: picked or confirmed by a person.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Choisi par</osd:label>
                                        <osd:description>LLM : suggéré par le modèle et conservé ; USER : choisi ou confirmé par une personne.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="LLM">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Language model</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Modèle de langage</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="USER">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">User</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Utilisateur</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="status" minOccurs="1" maxOccurs="1" default="CHOSEN">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Status</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Statut</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="CHOSEN">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Chosen</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Choisi</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="GENERATED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Generated</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Généré</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="Difference" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Differences</osd:label>
                            <osd:description>One difference between a pack and what the project needs, proposed by the language model and decided by a person.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Différences</osd:label>
                            <osd:description>Une différence entre un pack et ce dont le projet a besoin, proposée par le modèle de langage et décidée par une personne.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/id </primaryKeys>
                                <defaultLabel>${./nature} ${./what}</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" type="id" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="project" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Project</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Projet</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/Project</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="pass" type="xs:int" minOccurs="1" maxOccurs="1" default="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Pass</osd:label>
                                        <osd:description>1 model, 2 rules, 3 forms, 4 workflows and roles.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Passe</osd:label>
                                        <osd:description>1 modèle, 2 règles, 3 formulaires, 4 workflows et rôles.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="nature" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Nature</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Nature</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="ADD">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Add</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Ajout</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="CHANGE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Change</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Modification</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="REMOVE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Remove</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Retrait</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="USE_BLOCK">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Use a building block</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Utiliser un bloc</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="USE_LIBRARY">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Use a published library</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Utiliser une bibliothèque publiée</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="USE_WORKFLOW">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Use a workflow type</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Utiliser un type de workflow</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="KEEP">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Keep (pack element kept)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Conserver (élément du pack conservé)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="what" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>What</osd:label>
                                        <osd:description>The element concerned, in a few words.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Quoi</osd:label>
                                        <osd:description>L'élément concerné, en quelques mots.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="300"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="where" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Where</osd:label>
                                        <osd:description>Path of the pack element the difference applies to (a table, a field, a script, a workflow step).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Où</osd:label>
                                        <osd:description>Chemin de l'élément du pack auquel la différence s'applique (table, champ, script, étape de workflow).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="500"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="placeState" minOccurs="1" maxOccurs="1" default="PLACED">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Placement</osd:label>
                                        <osd:description>TO_PLACE: the check could not find the element named by &quot;where&quot; in the pack; a person says where it goes.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Placement</osd:label>
                                        <osd:description>TO_PLACE : la vérification n'a pas trouvé dans le pack l'élément nommé par « où » ; une personne dit où le mettre.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="PLACED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Placed on an element of the pack</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Placée sur un élément du pack</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="TO_PLACE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">To place (the element named is not in the pack)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">À placer (l'élément nommé n'est pas dans le pack)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="detail" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Detail (JSON)</osd:label>
                                        <osd:description>The difference itself as the model gave it: the field to add, the property to change, the parameters of the workflow type. Replaced by the person when she edits the line.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Détail (JSON)</osd:label>
                                        <osd:description>La différence elle-même telle que le modèle l'a donnée : le champ à ajouter, la propriété à changer, les paramètres du type de workflow. Remplacé par la personne quand elle modifie la ligne.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="20000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="why" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Why</osd:label>
                                        <osd:description>The reason of the model, in the words of the specification.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Pourquoi</osd:label>
                                        <osd:description>La raison donnée par le modèle, dans les mots de la spécification.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="packKey" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Pack</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Pack</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="blockKey" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Building block</osd:label>
                                        <osd:description>USE_BLOCK: key of the block.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Bloc</osd:label>
                                        <osd:description>USE_BLOCK : clé du bloc.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="libraryFunction" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Library function</osd:label>
                                        <osd:description>USE_LIBRARY: the published function wrapped by the rule.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Fonction de bibliothèque</osd:label>
                                        <osd:description>USE_LIBRARY : la fonction publiée enveloppée par la règle.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="200"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="workflowType" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Workflow type</osd:label>
                                        <osd:description>USE_WORKFLOW: key of the workflow type.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Type de workflow</osd:label>
                                        <osd:description>USE_WORKFLOW : clé du type de workflow.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="appliedObject" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Applied to</osd:label>
                                        <osd:description>What the generation wrote for this line (a path, a name); empty until APPLIED.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Appliqué à</osd:label>
                                        <osd:description>Ce que la génération a écrit pour cette ligne (chemin, nom) ; vide avant APPLIED.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="500"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="origin" minOccurs="1" maxOccurs="1" default="USER">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Origin</osd:label>
                                        <osd:description>Who proposed this difference: a deterministic rule, the language model, or a person.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Origine</osd:label>
                                        <osd:description>Qui a proposé la différence : une règle déterministe, le modèle de langage ou une personne.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="RULE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Rule</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Règle</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="LLM">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Language model</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Modèle de langage</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="USER">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">User</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Utilisateur</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="confidence" type="xs:int" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Confidence (%)</osd:label>
                                        <osd:description>0 to 100. Empty for a line entered by a person.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Confiance (%)</osd:label>
                                        <osd:description>De 0 à 100. Vide pour une ligne saisie par une personne.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="rationale" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Rationale</osd:label>
                                        <osd:description>Why it was proposed: the rule that fired, or the explanation given by the model.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Justification</osd:label>
                                        <osd:description>Pourquoi la proposition a été faite : la règle déclenchée, ou l'explication donnée par le modèle.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="status" minOccurs="1" maxOccurs="1" default="PROPOSED">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Status</osd:label>
                                        <osd:description>Nothing is generated from a line that is not accepted.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Statut</osd:label>
                                        <osd:description>Rien n'est généré depuis une ligne qui n'est pas acceptée.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="PROPOSED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Proposed</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Proposé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="ACCEPTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Accepted</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Accepté</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="REJECTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Rejected</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Refusé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="APPLIED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Applied</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Appliqué</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="DomainObject" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Domain objects</osd:label>
                            <osd:description>An object written by the generation of a CENTRALISATION domain, for the summary, step reset and project deletion.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Objets du domaine</osd:label>
                            <osd:description>Un objet écrit par la génération d'un domaine en CENTRALISATION, pour le résumé, la réinitialisation d'étape et la suppression de projet.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/id </primaryKeys>
                                <defaultLabel>${./kind} ${./name}</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" type="id" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="project" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Project</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Projet</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/Project</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="kind" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Kind</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Nature</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="DATA_MODEL">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Data model</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Modèle de données</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="PUBLICATION">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Publication</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Publication</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="DATASPACE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Dataspace</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Dataspace</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="DATASET">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Dataset</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Dataset</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="SCRIPT">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Script</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Script</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="WORKFLOW_MODEL">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Workflow model</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Modèle de workflow</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="WORKFLOW_PUBLICATION">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Workflow publication</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Publication de workflow</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="LAYOUT">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Form layout</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Mise en page de formulaire</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="MATCHING_POLICY">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Matching policy</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Politique de rapprochement</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="PERMISSIONS">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Permissions</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Permissions</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="REFERENCE_ROWS">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Reference data rows</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Lignes de données de référence</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="name" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Name</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Nom</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="200"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="path" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Path</osd:label>
                                        <osd:description>Where the object lives (dataspace/dataset, script path, model name).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Chemin</osd:label>
                                        <osd:description>Où vit l'objet (dataspace/dataset, chemin de script, nom du modèle).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="500"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="detail" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Detail</osd:label>
                                        <osd:description>A short remark; &quot;draft&quot; for a rule authored but held back until a person confirms it.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Détail</osd:label>
                                        <osd:description>Une courte remarque ; « draft » pour une règle écrite mais retenue jusqu'à confirmation par une personne.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="createdOn" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Created on</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Créé le</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="step" type="xs:string" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Pipeline step</osd:label>
                                        <osd:description>The pipeline step that wrote the object: step reset and project deletion follow it.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Étape du pipeline</osd:label>
                                        <osd:description>L'étape du pipeline qui a écrit l'objet : la réinitialisation d'étape et la suppression de projet la suivent.</osd:description>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/PipelineStep</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:simpleType name="id">
        <xs:annotation>
            <xs:appinfo>
                <osd:autoIncrement/>
            </xs:appinfo>
        </xs:annotation>
        <xs:restriction base="xs:int"/>
    </xs:simpleType>
</xs:schema>
