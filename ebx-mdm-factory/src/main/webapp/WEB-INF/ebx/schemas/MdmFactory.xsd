                                        </xs:enumeration>
                                        <xs:enumeration value="MASTER_MODEL">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Master: data model</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">MDM : modèle de données</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="MASTER_DATASET">
