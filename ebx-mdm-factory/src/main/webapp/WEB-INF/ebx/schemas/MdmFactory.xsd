                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="MATCHING_SUGGEST_LLM">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Master: matching suggestion (language model)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">MDM : suggestion de rapprochement (modèle de langage)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="MATCHING_CONFIG">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Master: matching configuration</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">MDM : configuration du rapprochement</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="MATCHING_RUN">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Master: matching run</xs:documentation>
