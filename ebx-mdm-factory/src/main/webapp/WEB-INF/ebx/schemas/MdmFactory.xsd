                                                <column>/sourceColumn</column>
                                                <column>/fieldName</column>
                                                <column>/sourceDataType</column>
                                                <column>/sourceKey</column>
                                                <column>/fillRate</column>
                                                <column>/distinctCount</column>
                                                <column>/inferredType</column>
