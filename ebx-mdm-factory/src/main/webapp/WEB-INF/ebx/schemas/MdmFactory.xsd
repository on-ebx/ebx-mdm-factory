                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>References</osd:label>
                                        <osd:description>Relations where this table is the child: its columns point to another table.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Références</osd:label>
                                        <osd:description>Relations où cette table est enfant : ses colonnes pointent vers une autre table.</osd:description>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:association>
                                            <tableRefInverse>
                                                <fieldToSource>/root/LandingRelation/fromTable</fieldToSource>
