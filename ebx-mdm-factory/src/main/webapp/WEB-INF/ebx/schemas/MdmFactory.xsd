                            <xs:element name="scope" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Scope</osd:label>
                                        <osd:description>The source system or the entity the step ran for; empty for the whole project.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Périmètre</osd:label>
                                        <osd:description>Le système source ou l'entité concernés ; vide pour tout le projet.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="status" minOccurs="1" maxOccurs="1" default="PENDING">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Status</osd:label>
                                        <osd:description>RESET: a DONE step a later master/reset invalidated - not deleted, so history stays, but isDone must treat it as not-done again.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Statut</osd:label>
                                        <osd:description>RESET : une étape DONE qu'une réinitialisation ultérieure du MDM a invalidée - pas supprimée, l'historique reste, mais isDone doit à nouveau la considérer comme non terminée.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="PENDING">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Pending</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">En attente</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="RUNNING">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Running</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">En cours</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="DONE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Done</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Terminé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="FAILED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Failed</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">En échec</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="SKIPPED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Skipped</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Ignoré</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="RESET">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Reset</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Réinitialisé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="INTERRUPTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Interrupted (server restart)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Interrompu (redémarrage du serveur)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="STOPPED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Stopped</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Arrêté</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="startedBy" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Started by</osd:label>
                                        <osd:description>The EBX user who triggered the step: the person in the wizard or behind a REST route, the LAUNCHER of the workflow instance for a workflow step (script tasks themselves run as the system user).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Démarré par</osd:label>
                                        <osd:description>L'utilisateur EBX qui a déclenché l'étape : la personne dans l'assistant ou derrière une route REST, le LANCEUR de l'instance de workflow pour une étape de workflow (les tâches de script tournent elles-mêmes en utilisateur système).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="via" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Via</osd:label>
                                        <osd:description>session (wizard or REST), or workflow &lt;process instance key&gt;.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Via</osd:label>
                                        <osd:description>session (assistant ou REST), ou workflow &lt;clé de l'instance&gt;.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="200"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="startedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Started</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Début</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="endedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Ended</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Fin</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="message" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Message</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Message</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="detail" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Detail (JSON)</osd:label>
                                        <osd:description>What was sent and what came back, for a replay or a diagnosis.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Détail (JSON)</osd:label>
                                        <osd:description>Ce qui a été envoyé et ce qui est revenu, pour un rejeu ou un diagnostic.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="100000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="AgentRun" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Agent runs</osd:label>
                            <osd:description>One conversation between the factory and the language model, with its cost.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Exécutions de l'agent</osd:label>
                            <osd:description>Une conversation entre la factory et le modèle de langage, avec son coût.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/id </primaryKeys>
                                <defaultLabel>${./phase} ${./startedAt}</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" type="id" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="project" type="xs:string" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Project</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Projet</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/Project</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="phase" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Phase</osd:label>
                                        <osd:description>Decides which tools the model is shown.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Phase</osd:label>
                                        <osd:description>Décide des outils montrés au modèle.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="goal" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Goal</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Objectif</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="8000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="llmConnector" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Language model connector</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Connecteur du modèle de langage</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="model" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Model</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Modèle</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="status" minOccurs="1" maxOccurs="1" default="RUNNING">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Status</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Statut</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="RUNNING">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Running</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">En cours</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="DONE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Done</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Terminé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="FAILED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Failed</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">En échec</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="BUDGET">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Stopped: budget reached</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Arrêté : budget atteint</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="INTERRUPTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Interrupted (server restart)</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Interrompu (redémarrage du serveur)</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="steps" type="xs:int" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Steps</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Pas</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="inputTokens" type="xs:decimal" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Input tokens</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Jetons en entrée</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="outputTokens" type="xs:decimal" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Output tokens</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Jetons en sortie</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="startedBy" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Started by</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Lancé par</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="startedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Started</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Début</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="endedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Ended</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Fin</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="outcome" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Outcome</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Résultat</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="8000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="agent" type="xs:string" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Agent</osd:label>
                                        <osd:description>The declared agent this run executed; empty for a pass of the Factory itself.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Agent</osd:label>
                                        <osd:description>L'agent déclaré que cette exécution a fait tourner ; vide pour une passe de la Factory elle-même.</osd:description>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/AgentDefinition</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="actingFor" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Acting for</osd:label>
                                        <osd:description>The EBX user whose permissions bound every action of the run (the person who launched it, or who switched the agent on for an event or a schedule).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Agit pour</osd:label>
                                        <osd:description>L'utilisateur EBX dont les permissions bornent chaque action de l'exécution (la personne qui l'a lancée, ou qui a activé l'agent pour un événement ou un planning).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="via" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Via</osd:label>
                                        <osd:description>manual, event &lt;name&gt;, schedule, or workflow &lt;instance&gt;.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Via</osd:label>
                                        <osd:description>manuel, événement &lt;nom&gt;, planning ou workflow &lt;instance&gt;.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="200"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="inputs" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Inputs (JSON)</osd:label>
                                        <osd:description>What the agent was shown: the records, pairs or findings it decided on.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Entrées (JSON)</osd:label>
                                        <osd:description>Ce qui a été montré à l'agent : les enregistrements, paires ou constats sur lesquels il a décidé.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="100000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="decision" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Decision (JSON)</osd:label>
                                        <osd:description>The decisions as the agent returned them, each with its confidence and the disposition the runner gave it.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Décision (JSON)</osd:label>
                                        <osd:description>Les décisions telles que l'agent les a rendues, chacune avec sa confiance et le sort que le moteur lui a donné.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="100000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="confidence" type="xs:int" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Lowest confidence (%)</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Confiance la plus basse (%)</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="applied" type="xs:int" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Applied</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Appliquées</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="escalated" type="xs:int" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Escalated</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Escaladées</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="refused" type="xs:int" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Refused</osd:label>
                                        <osd:description>Decisions the runner refused: an action outside the agent's allow-list, or one the acting user's EBX permissions do not allow.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Refusées</osd:label>
                                        <osd:description>Décisions refusées par le moteur : une action hors de la liste autorisée de l'agent, ou que les permissions EBX de l'utilisateur ne permettent pas.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="escalation" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Escalation workflow</osd:label>
                                        <osd:description>Key of the workflow instance offering the review to the owner profile.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Workflow d'escalade</osd:label>
                                        <osd:description>Clé de l'instance de workflow qui propose la revue au profil propriétaire.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="200"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="proposals" type="xs:string" minOccurs="0" maxOccurs="0">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Proposals</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Propositions</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:association>
                                            <tableRefInverse>
                                                <fieldToSource>/root/AgentProposal/run</fieldToSource>
                                            </tableRefInverse>
                                        </osd:association>
                                        <osd:defaultView>
                                            <displayMode>tab</displayMode>
                                            <tabularView>
                                                <column>/target</column>
                                                <column>/action</column>
                                                <column>/confidence</column>
                                                <column>/status</column>
                                                <initialQueryEnabled>true</initialQueryEnabled>
                                            </tabularView>
                                        </osd:defaultView>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="trace" type="xs:string" minOccurs="0" maxOccurs="0">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Trace</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Trace</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:association>
                                            <tableRefInverse>
                                                <fieldToSource>/root/AgentStep/run</fieldToSource>
                                            </tableRefInverse>
                                        </osd:association>
                                        <osd:defaultView>
                                            <displayMode>tab</displayMode>
                                            <tabularView>
                                                <column>/stepIndex</column>
                                                <column>/kind</column>
                                                <column>/server</column>
                                                <column>/tool</column>
                                                <column>/error</column>
                                                <column>/durationMs</column>
                                                <initialQueryEnabled>true</initialQueryEnabled>
                                            </tabularView>
                                        </osd:defaultView>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="AgentStep" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Agent steps</osd:label>
                            <osd:description>What the model said, which tool it called with which arguments, and what came back.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Pas de l'agent</osd:label>
                            <osd:description>Ce que le modèle a dit, quel outil il a appelé avec quels arguments, et ce qui est revenu.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/id </primaryKeys>
                                <defaultLabel>${./stepIndex} ${./tool}</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" type="id" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="run" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Run</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Exécution</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/AgentRun</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="stepIndex" type="xs:int" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>#</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>N°</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="kind" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Kind</osd:label>
                                        <osd:description>REFUSED: the model asked for a tool outside the allow-list of the phase; nothing was called.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Nature</osd:label>
                                        <osd:description>REFUSED : le modèle a demandé un outil hors de la liste blanche de la phase ; rien n'a été appelé.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="MODEL">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Model turn</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Tour du modèle</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="TOOL">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Tool call</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Appel d'outil</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="REFUSED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Tool refused</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Outil refusé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="server" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>MCP server</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Serveur MCP</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="tool" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Tool</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Outil</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="arguments" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Arguments</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Arguments</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="100000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="result" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Result (truncated)</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Résultat (tronqué)</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="100000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="error" type="xs:boolean" minOccurs="0" maxOccurs="1" default="false">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Error?</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Erreur ?</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="durationMs" type="xs:int" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Duration (ms)</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Durée (ms)</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="occurredAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>At</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Le</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="AgentDefinition" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Agents</osd:label>
                            <osd:description>Agents declared as data: purpose, trigger, allowed tools, autonomy and owner.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Agents</osd:label>
                            <osd:description>Agents déclarés comme des données : objectif, déclencheur, outils autorisés, autonomie et propriétaire.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/code </primaryKeys>
                                <defaultLabel>${./code} ${./label}</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="code" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Code</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Code</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="40"/>
                                        <xs:pattern value="[A-Za-z][A-Za-z0-9_-]*"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="label" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Label</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Libellé</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="200"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="purpose" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Purpose</osd:label>
                                        <osd:description>What the agent is for, in plain words; shown to the model and to the reviewer.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Objectif</osd:label>
                                        <osd:description>À quoi sert l'agent, en mots simples ; montré au modèle et à la personne qui revoit.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="4000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="kind" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Behaviour</osd:label>
                                        <osd:description>What the agent reads and what an accepted decision does.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Comportement</osd:label>
                                        <osd:description>Ce que l'agent lit et ce que fait une décision acceptée.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="STEWARD_MATCH">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Data steward: Match and Merge suspects</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Data steward : suspects du rapprochement</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="QUALITY_FIX">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Quality: corrections of records flagged by validation</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Qualité : corrections des enregistrements signalés par la validation</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="project" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Project</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Projet</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/Project</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="entity" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Entity</osd:label>
                                        <osd:description>The staging entity the agent works on (its master table for the data steward agent). Empty: every entity of the project.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Entité</osd:label>
                                        <osd:description>L'entité de staging sur laquelle travaille l'agent (sa table maître pour l'agent data steward). Vide : toutes les entités du projet.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="zone" minOccurs="0" maxOccurs="1" default="MASTER">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Zone</osd:label>
                                        <osd:description>Quality agent: the zone whose validation report it reads.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Zone</osd:label>
                                        <osd:description>Agent qualité : la zone dont il lit le rapport de validation.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="STAGING">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Staging</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Staging</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="MASTER">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Master</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">MDM</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="trigger" minOccurs="1" maxOccurs="1" default="MANUAL">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Trigger</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Déclencheur</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="MANUAL">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Manual</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Manuel</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="EVENT">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Factory event</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Événement de la Factory</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="SCHEDULE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Schedule</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Planning</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="triggerEvent" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Event</osd:label>
                                        <osd:description>Trigger EVENT: the Factory event that wakes the agent.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Événement</osd:label>
                                        <osd:description>Déclencheur EVENT : l'événement de la Factory qui réveille l'agent.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="MATCHING_RUN_DONE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">A matching run ended</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Un rapprochement est terminé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="MASTER_LOAD_DONE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">A master load ended</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Un chargement MDM est terminé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="STAGING_LOAD_DONE">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">A staging load ended</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Un chargement staging est terminé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="scheduleMinutes" type="xs:int" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Every (minutes)</osd:label>
                                        <osd:description>Trigger SCHEDULE: the shortest time between two runs (the scheduled task ticks, the agent runs when this much time has passed).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Toutes les (minutes)</osd:label>
                                        <osd:description>Déclencheur SCHEDULE : le délai minimal entre deux exécutions (la tâche planifiée passe, l'agent tourne quand ce délai est écoulé).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="allowedTools" minOccurs="0" maxOccurs="unbounded">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Allowed tools</osd:label>
                                        <osd:description>The allow-list: factory:&lt;action&gt; (factory:suspect.decide, factory:record.correct), &lt;mcp server&gt;/&lt;tool&gt;, &lt;mcp server&gt;/* or connectors:&lt;flow&gt;. A decision whose tool is not listed is refused and recorded.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Outils autorisés</osd:label>
                                        <osd:description>La liste autorisée : factory:&lt;action&gt; (factory:suspect.decide, factory:record.correct), &lt;serveur mcp&gt;/&lt;outil&gt;, &lt;serveur mcp&gt;/* ou connectors:&lt;flux&gt;. Une décision dont l'outil n'est pas listé est refusée et tracée.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="200"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="autonomy" minOccurs="1" maxOccurs="1" default="SUGGEST">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Autonomy</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Autonomie</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="SUGGEST">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Suggest only</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Suggère seulement</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="ACT_WITH_APPROVAL">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Act after approval</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Agit après approbation</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="ACT">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Act alone above the threshold</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Agit seul au-dessus du seuil</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="confidenceThreshold" type="xs:int" minOccurs="1" maxOccurs="1" default="90">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Confidence threshold (%)</osd:label>
                                        <osd:description>ACT: a decision below it is escalated instead of applied.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Seuil de confiance (%)</osd:label>
                                        <osd:description>ACT : une décision en dessous est escaladée au lieu d'être appliquée.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="ownerProfile" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Owner profile</osd:label>
                                        <osd:description>The EBX profile the review task is offered to: R&lt;role&gt;, U&lt;user&gt; or Badministrator.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Profil propriétaire</osd:label>
                                        <osd:description>Le profil EBX auquel la tâche de revue est proposée : R&lt;rôle&gt;, U&lt;utilisateur&gt; ou Badministrator.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="maxItems" type="xs:int" minOccurs="0" maxOccurs="1" default="20">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Items per run</osd:label>
                                        <osd:description>How many pairs or records one run shows the model at most.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Éléments par exécution</osd:label>
                                        <osd:description>Combien de paires ou d'enregistrements une exécution montre au plus au modèle.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="instructions" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Extra instructions</osd:label>
                                        <osd:description>Added to the prompt after the behaviour's own instructions (house rules of the steward team).</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Consignes supplémentaires</osd:label>
                                        <osd:description>Ajoutées au prompt après les consignes du comportement (règles maison de l'équipe).</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="4000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="enabled" type="xs:boolean" minOccurs="1" maxOccurs="1" default="false">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Enabled</osd:label>
                                        <osd:description>An event or a schedule only wakes an enabled agent; a manual run works either way.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Activé</osd:label>
                                        <osd:description>Un événement ou un planning ne réveille qu'un agent activé ; une exécution manuelle marche dans tous les cas.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="enabledBy" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Enabled by</osd:label>
                                        <osd:description>Who switched it on: an event or scheduled run acts for this person, with this person's EBX permissions, while the person still holds the Factory right STEWARD.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Activé par</osd:label>
                                        <osd:description>Qui l'a activé : une exécution sur événement ou planifiée agit pour cette personne, avec ses permissions EBX, tant qu'elle détient le droit Factory STEWARD.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="lastRunAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Last run</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Dernière exécution</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="runs" type="xs:string" minOccurs="0" maxOccurs="0">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Runs</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Exécutions</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:association>
                                            <tableRefInverse>
                                                <fieldToSource>/root/AgentRun/agent</fieldToSource>
                                            </tableRefInverse>
                                        </osd:association>
                                        <osd:defaultView>
                                            <displayMode>tab</displayMode>
                                            <tabularView>
                                                <column>/status</column>
                                                <column>/applied</column>
                                                <column>/escalated</column>
                                                <column>/refused</column>
                                                <column>/startedAt</column>
                                                <initialQueryEnabled>true</initialQueryEnabled>
                                            </tabularView>
                                        </osd:defaultView>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="AgentProposal" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Agent proposals</osd:label>
                            <osd:description>One decision of an agent waiting for, or after, a human review.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Propositions d'agent</osd:label>
                            <osd:description>Une décision d'agent en attente de revue humaine, ou revue.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/id </primaryKeys>
                                <defaultLabel>${./action} ${./target}</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="id" type="id" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Id</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="run" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Run</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Exécution</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/AgentRun</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="agent" type="xs:string" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Agent</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Agent</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/AgentDefinition</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="project" type="xs:string" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Project</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Projet</osd:label>
                                    </xs:documentation>
                                    <xs:appinfo>
                                        <osd:otherFacets>
                                            <osd:tableRef>
                                                <tablePath>/root/Project</tablePath>
                                            </osd:tableRef>
                                        </osd:otherFacets>
                                    </xs:appinfo>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="tool" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Tool</osd:label>
                                        <osd:description>The allow-list entry the action goes through.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Outil</osd:label>
                                        <osd:description>L'entrée de la liste autorisée par laquelle passe l'action.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="200"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="target" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Target</osd:label>
                                        <osd:description>What the decision is about: a suspect pair (golden|suspect) or a record and field.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Cible</osd:label>
                                        <osd:description>Ce sur quoi porte la décision : une paire suspecte (golden|suspect) ou un enregistrement et un champ.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="400"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="action" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Action</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Action</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="80"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="arguments" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Arguments (JSON)</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Arguments (JSON)</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="20000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="confidence" type="xs:int" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Confidence (%)</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Confiance (%)</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="rationale" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Rationale</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Justification</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="4000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="status" minOccurs="1" maxOccurs="1" default="PROPOSED">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Status</osd:label>
                                        <osd:description>Set by the module. A person decides a line in the review task or with the decide route, never by editing it here: the accepted lines of an agent allowed to act are then applied with the permissions of the person who decided.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Statut</osd:label>
                                        <osd:description>Posé par le module. Une personne décide d'une ligne dans la tâche de revue ou par la route de décision, jamais en la modifiant ici : les lignes acceptées d'un agent autorisé à agir sont alors appliquées avec les permissions de la personne qui a décidé.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="PROPOSED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Proposed</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Proposé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="ACCEPTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Accepted</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Accepté</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="REJECTED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Rejected</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Refusé</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="APPLIED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Applied</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Appliqué</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="FAILED">
                                            <xs:annotation>
                                                <xs:documentation xml:lang="en-US">Apply failed</xs:documentation>
                                                <xs:documentation xml:lang="fr-FR">Échec de l'application</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:maxLength value="40"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="applyAfterApproval" type="xs:boolean" minOccurs="0" maxOccurs="1" default="false">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Applied on approval</osd:label>
                                        <osd:description>True when the agent may act once a person approves (ACT_WITH_APPROVAL, or ACT below the threshold); false for a suggestion only.</osd:description>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Appliquée à l'approbation</osd:label>
                                        <osd:description>Vrai quand l'agent peut agir une fois qu'une personne approuve (ACT_WITH_APPROVAL, ou ACT sous le seuil) ; faux pour une simple suggestion.</osd:description>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="decidedBy" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Decided by</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Décidée par</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:maxLength value="120"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="decidedAt" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Decided</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Décidée le</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="applyMessage" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Apply message</osd:label>
                                    </xs:documentation>
                                    <xs:documentation xml:lang="fr-FR">
                                        <osd:label>Message d'application</osd:label>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                    <xs:restriction base="osd:text">
                                        <xs:maxLength value="2000"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="Xref" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation xml:lang="en-US">
                            <osd:label>Cross-references</osd:label>
                            <osd:description>Which source row became which master record, through which landing and staging rows: what the record lineage screen reads.</osd:description>
                        </xs:documentation>
                        <xs:documentation xml:lang="fr-FR">
                            <osd:label>Références croisées</osd:label>
                            <osd:description>Quelle ligne source est devenue quel enregistrement MDM, par quelles lignes de landing et de staging : ce que lit l'écran de lineage de l'enregistrement.</osd:description>
                        </xs:documentation>
                        <xs:appinfo>
                            <osd:table>
                                <primaryKeys>/project /stagingTable /stagingKey </primaryKeys>
                                <defaultLabel>${./sourceSystem}:${./sourceId} -&gt; ${./masterKey}</defaultLabel>
                                <defaultView>
                                    <defaultViewForGroups>expanded</defaultViewForGroups>
                                </defaultView>
                            </osd:table>
                        </xs:appinfo>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="project" type="xs:string" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                    <xs:documentation xml:lang="en-US">
                                        <osd:label>Project</osd:label>
                                    </xs:documentation>
