{
 "dataContext": {
  "variables": [
   {
    "name": "workDataspace",
    "direction": "inout"
   },
   {
    "name": "recordXPath",
    "defaultValue": "-",
    "direction": "inout"
   }
  ]
 },
 "model": {
  "name": "${modelName}",
  "label": {
   "en_US": "[${domainLabel}] Create a ${entityLabel} with review",
   "fr_FR": "[${domainLabel}] Créer ${entityLabelFr} avec validation"
  },
  "description": {
   "en_US": "Generated by the MDM Factory (pack ${packKey} ${packVersion}): creation in a child dataspace, review, merge into the domain.",
   "fr_FR": "Généré par la MDM Factory (pack ${packKey} ${packVersion}) : création dans un espace enfant, validation, fusion vers le domaine."
  },
  "owner": "Badministrator",
  "launching": {
   "quick": true,
   "synchronous": true
  },
  "permissionsOnInstances": {
   "create": "${requesterProfile}",
   "agentAccessForAdmin": "Badministrator",
   "agentAccessForInbox": "Badministrator",
   "creatorIsViewer": true
  },
  "modelOrientation": 0,
  "startNodeId": 0
 },
 "nodes": [
  {
   "nodeId": 0,
   "kind": "scriptTask",
   "label": "Create the work dataspace",
   "description": "Child dataspace of ${domainDataspace}: the creation stays invisible until it is approved.",
   "firstInProcess": true,
   "hiddenInGraphicalView": false,
   "scriptClass": "ebx-root-1.0@com.orchestranetworks.workflow.beans.ScriptTaskCreateBranchI18n",
   "beanParams": [
    {
     "name": "initialBranch",
     "value": "${domainDataspace}"
    },
    {
     "name": "label",
     "value": "${entityLabel} creation"
    },
    {
     "name": "description",
     "value": "Dataspace created by the ${modelName} workflow."
    },
    {
     "name": "ensureBranchClosingOnWorkflowTermination",
     "value": "true"
    }
   ],
   "scriptMode": "library",
   "scriptLibrary": true,
   "outputMappingParams": [
    {
     "name": "newHome",
     "value": "workDataspace"
    }
   ]
  },
  {
   "nodeId": 1,
   "kind": "userTask",
   "label": "Enter the new ${entityLabel}",
   "description": "The checks show while typing; duplicates are reviewed before the request goes on.",
   "hiddenInGraphicalView": false,
   "executionModeOfNextStep": "synchronous",
   "userTaskVersion": 2,
   "agentAccess": "allowed",
   "agentGuidance": "askHuman",
   "serviceDeclarationKey": "ebx-root-1.0@creation",
   "profiles": [
    "${requesterProfile}"
   ],
   "offeredToProfiles": [
    "${requesterProfile}"
   ],
   "input": {
    "parameters": [
     {
      "name": "service",
      "value": "@creation"
     },
     {
      "name": "branch",
      "value": "${workDataspace}"
     },
     {
      "name": "instance",
      "value": "${domainDataset}"
     },
     {
      "name": "xpath",
      "value": "${tablePath}"
     }
    ]
   },
   "output": {
    "parameters": [
     {
      "name": "created",
      "value": "recordXPath"
     }
    ]
   },
   "enableReject": true,
   "enableConfirmationRequest": true,
   "enableComment": true,
   "commentStrategyCode": "requiredIfRejected",
   "customizedAcceptLabel": {
    "en_US": "Submit for review",
    "fr_FR": "Soumettre à validation"
   },
   "customizedRejectLabel": {
    "en_US": "Cancel the request",
    "fr_FR": "Abandonner la demande"
   },
   "termination": {
    "completionStrategy": "allWorkItemsCompleted",
    "rejectionThreshold": 0
   }
  },
  {
   "nodeId": 2,
   "kind": "condition",
   "label": "Submitted?",
   "hiddenInGraphicalView": false,
   "scriptClass": "ebx-root-1.0@com.orchestranetworks.workflow.beans.ConditionIsLastUserTaskAccepted",
   "conditionLibrary": true
  },
  {
   "nodeId": "${reviewNodes}",
   "_note": "one userTask (@default, xpath ${recordXPath}, firstCallDisplay record, profile = reviewer, accept/reject labels) + one ConditionIsLastUserTaskAccepted per reviewer, in order; ifTrue chains to the next reviewer, the last ifTrue goes to MERGE; every ifFalse goes to CORRECT"
  },
  {
   "nodeId": "${mergeNode}",
   "kind": "scriptTask",
   "label": "Merge into the domain",
   "hiddenInGraphicalView": false,
   "scriptClass": "ebx-root-1.0@com.orchestranetworks.workflow.beans.ScriptTaskMergeBranch",
   "beanParams": [
    {
     "name": "branchName",
     "value": "${workDataspace}"
    }
   ],
   "scriptMode": "library",
   "scriptLibrary": true
  },
  {
   "nodeId": "${closeNode}",
   "kind": "scriptTask",
   "label": "Close the dataspace",
   "description": "Request cancelled: nothing is published.",
   "hiddenInGraphicalView": false,
   "scriptClass": "ebx-root-1.0@com.orchestranetworks.workflow.beans.ScriptTaskCloseBranch",
   "beanParams": [
    {
     "name": "branchName",
     "value": "${workDataspace}"
    }
   ],
   "scriptMode": "library",
   "scriptLibrary": true
  },
  {
   "nodeId": "${correctNode}",
   "kind": "userTask",
   "label": "Correct the request",
   "description": "Sent back: read the comment, correct the record, resubmit or cancel.",
   "hiddenInGraphicalView": false,
   "userTaskVersion": 2,
   "agentAccess": "allowed",
   "agentGuidance": "askHuman",
   "serviceDeclarationKey": "ebx-root-1.0@default",
   "profiles": [
    "${requesterProfile}"
   ],
   "offeredToProfiles": [
    "${requesterProfile}"
   ],
   "previousUserTaskIdReferenceForAllocation": "1",
   "input": {
    "parameters": [
     {
      "name": "branch",
      "value": "${workDataspace}"
     },
     {
      "name": "instance",
      "value": "${domainDataset}"
     },
     {
      "name": "xpath",
      "value": "${recordXPath}"
     },
     {
      "name": "firstCallDisplay",
      "value": "record"
     }
    ]
   },
   "enableReject": true,
   "enableConfirmationRequest": true,
   "enableComment": true,
   "commentStrategyCode": "requiredIfRejected",
   "customizedAcceptLabel": {
    "en_US": "Resubmit",
    "fr_FR": "Renvoyer en validation"
   },
   "customizedRejectLabel": {
    "en_US": "Cancel the request",
    "fr_FR": "Abandonner la demande"
   },
   "termination": {
    "completionStrategy": "allWorkItemsCompleted",
    "rejectionThreshold": 0
   }
  },
  {
   "nodeId": "${correctCondition}",
   "kind": "condition",
   "label": "Resubmitted?",
   "hiddenInGraphicalView": false,
   "scriptClass": "ebx-root-1.0@com.orchestranetworks.workflow.beans.ConditionIsLastUserTaskAccepted",
   "conditionLibrary": true
  }
 ],
 "links": "${links}",
 "_measured": "docs/ACCELERATORS.md section 14: AccelProbeSupplierCreation ran end to end on 2026-10-12 with one reviewer; the output mapping orientation {name: service output, value: variable} is the working one."
}